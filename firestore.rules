// GENERATED FILE — edit firestore_rules/*.rules and run: node scripts/build_firestore_rules.mjs
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
// --- Firestore rules modules (table of contents) ---
    // Edit source fragments under firestore_rules/*.rules, then rebuild:
    //   node scripts/build_firestore_rules.mjs
    //
    // Modules (assembled in lexicographic order):
    //   00_index.rules                      — this table of contents
    //   01_core.functions.rules             — core auth/admin/resident helpers
    //   02_connection.functions.rules       — connection participant helpers
    //   03_chat.functions.rules             — chat participant helpers
    //   04_borrow.functions.rules           — borrow request helpers
    //   05_user.functions.rules             — user profile update helpers
    //   06_completion.functions.rules       — borrow completion counter helpers
    //   07_item.functions.rules              — item listing helpers
    //   08_service.functions.rules          — service listing helpers
    //   09_review.functions.rules           — review and profile image helpers
    //   10_collections_users.rules          — users collection
    //   11_collections_verification.rules   — verificationRequests collection
    //   12_collections_marketplace.rules    — items collection (marketplace)
    //   13_collections_reviews_reports.rules — reviews and reports collections
    //   14_collections_connections.rules    — connections collection
    //   15_collections_chat.rules           — chats collection
    //   16_collections_notifications.rules  — notifications collection
    //   17_community_post.functions.rules   — community post validation helpers
    //   18_collections_community.rules      — communityPosts and default deny

// --- Core auth/admin/resident helpers ---
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function myAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasAdminProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidAdminDoc(data) {
      return data.isActive != false &&
        data.role in ['communityAdmin', 'systemAdmin'];
    }

    function isAdmin() {
      return hasAdminProfile() && isValidAdminDoc(myAdminDoc().data);
    }

    function isSystemAdmin() {
      return hasAdminProfile() &&
        isValidAdminDoc(myAdminDoc().data) &&
        myAdminDoc().data.role == 'systemAdmin';
    }

    function adminCommunityId() {
      return myAdminDoc().data.communityId;
    }

    function adminCanAccessCommunity(communityId) {
      return isSystemAdmin() ||
        (
          isAdmin() &&
          communityId is string &&
          communityId != '' &&
          communityId == adminCommunityId()
        );
    }

    function hasVerifiedResidentStatus(status) {
      return status in ['verified', 'approved'];
    }

    function isVerifiedResident() {
      return hasProfile() &&
        hasVerifiedResidentStatus(myUserDoc().data.verificationStatus);
    }

    function isVerifiedResidentData(data) {
      return data.role == 'resident' &&
        hasVerifiedResidentStatus(data.verificationStatus);
    }

    function canReadCommunityResident(data) {
      return isVerifiedResident() &&
        isVerifiedResidentData(data) &&
        data.communityId == myUserDoc().data.communityId;
    }

// --- Connection participant helpers ---
    function isValidConnectionParticipants(data) {
      return data.participants is list &&
        data.participants.size() == 2 &&
        data.fromUserId in data.participants &&
        data.toUserId in data.participants;
    }

    function connectionParticipant(data) {
      return signedIn() &&
        data.participants is list &&
        request.auth.uid in data.participants;
    }

    function connectionParticipantQuery(data) {
      return signedIn() &&
        request.auth.uid in data.participants;
    }

    function connectionOwnedByCurrentUser(data) {
      return signedIn() &&
        (data.fromUserId == request.auth.uid || data.toUserId == request.auth.uid);
    }

    function targetUserCanConnect(data) {
      return data.toUserId is string &&
        exists(/databases/$(database)/documents/users/$(data.toUserId)) &&
        isVerifiedResidentData(userDoc(data.toUserId).data) &&
        userDoc(data.toUserId).data.communityId == myUserDoc().data.communityId;
    }

    function preservesConnectionIdentity() {
      return request.resource.data.fromUserId == resource.data.fromUserId &&
        request.resource.data.toUserId == resource.data.toUserId &&
        request.resource.data.communityId == resource.data.communityId &&
        request.resource.data.participants == resource.data.participants &&
        isValidConnectionParticipants(request.resource.data);
    }

    function senderCanRefreshPendingRequest() {
      return signedIn() &&
        request.auth.uid == resource.data.fromUserId &&
        resource.data.status in ['pending', 'declined'] &&
        request.resource.data.keys().hasOnly([
          'fromUserId',
          'toUserId',
          'participants',
          'communityId',
          'status',
          'createdAt',
          'updatedAt',
        ]) &&
        preservesConnectionIdentity() &&
        request.resource.data.status == 'pending';
    }

    function recipientCanResolvePendingRequest() {
      return signedIn() &&
        request.auth.uid == resource.data.toUserId &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
        ]) &&
        request.resource.data.status in ['accepted', 'declined'];
    }

    function participantCanDeleteConnection() {
      return connectionParticipant(resource.data) &&
        (
          resource.data.status == 'accepted' ||
          (
            resource.data.status == 'pending' &&
            request.auth.uid == resource.data.fromUserId
          )
        );
    }

// --- Chat participant helpers ---
    function isValidChatParticipants(data) {
      return data.participantIds is list &&
        data.participantIds.size() == 2 &&
        request.auth.uid in data.participantIds;
    }

    function chatParticipant(data) {
      return signedIn() &&
        (
          (
            data.participantIds is list &&
            request.auth.uid in data.participantIds
          ) ||
          (
            data.participantLookup is map &&
            data.participantLookup[request.auth.uid] == true
          )
        );
    }

    function chatParticipantLookup(data) {
      return signedIn() &&
        data.participantLookup is map &&
        data.participantLookup[request.auth.uid] == true;
    }

    function chatParticipantById(chatId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        chatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data);
    }

    function chatParticipantByIdAfter(chatId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        chatParticipant(getAfter(/databases/$(database)/documents/chats/$(chatId)).data);
    }

    function chatParticipantsAreVerifiedResidents(data) {
      return isValidChatParticipants(data) &&
        exists(/databases/$(database)/documents/users/$(data.participantIds[0])) &&
        exists(/databases/$(database)/documents/users/$(data.participantIds[1])) &&
        isVerifiedResidentData(userDoc(data.participantIds[0]).data) &&
        isVerifiedResidentData(userDoc(data.participantIds[1]).data) &&
        userDoc(data.participantIds[0]).data.communityId == myUserDoc().data.communityId &&
        userDoc(data.participantIds[1]).data.communityId == myUserDoc().data.communityId &&
        data.communityId == myUserDoc().data.communityId;
    }

    function validChatParticipantLookup(data) {
      return data.participantLookup is map &&
        data.participantLookup[data.participantIds[0]] == true &&
        data.participantLookup[data.participantIds[1]] == true;
    }

    function validChatCreate(data) {
      return isVerifiedResident() &&
        data.keys().hasOnly([
          'participantIds',
          'communityId',
          'connectionId',
          'participantNames',
          'participantImageUrls',
          'participantLookup',
          'lastMessageText',
          'lastMessageType',
          'lastMessageAt',
          'lastSenderId',
          'unreadCounts',
          'deletedFor',
          'createdAt',
          'updatedAt',
        ]) &&
        chatParticipantsAreVerifiedResidents(data) &&
        validChatParticipantLookup(data) &&
        data.deletedFor is list &&
        data.deletedFor.size() == 0;
    }

    function validChatUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return chatParticipant(resource.data) &&
        !changed.hasAny([
          'participantIds',
          'communityId',
          'connectionId',
          'createdAt',
        ]);
    }

    function chatBelongsToMyCommunity(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.communityId ==
        myUserDoc().data.communityId;
    }

    function validChatMessageCreate(chatId, data) {
      return isVerifiedResident() &&
        chatParticipantById(chatId) &&
        chatBelongsToMyCommunity(chatId) &&
        data.chatId == chatId &&
        data.senderId == request.auth.uid;
    }

    function validChatMessageReadUpdate(chatId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return chatParticipantByIdAfter(chatId) &&
        changed.hasOnly(['readBy']) &&
        request.resource.data.readBy is list &&
        request.auth.uid in request.resource.data.readBy;
    }

    function validChatMessageDeleteForUser(chatId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let before = resource.data.get('deletedFor', []);
      let after = request.resource.data.deletedFor;
      return chatParticipantById(chatId) &&
        changed.hasOnly(['deletedFor']) &&
        after is list &&
        before is list &&
        request.auth.uid in after &&
        after.hasAll(before) &&
        (request.auth.uid in before || after.size() == before.size() + 1);
    }

// --- Borrow request helpers ---
    //
    // Borrow status state machine (primary path):
    //   pending ──owner approve──► approved ──borrower pay──► approved+paid
    //        │                         │
    //        ├──owner reject──► rejected
    //        └──borrower cancel──► cancelled
    //   approved+paid ──owner handover──► pickupReady ──borrower confirm──► active
    //   active ──borrower return──► returnSubmitted ──owner inspect──► completed
    //        │                                              ├── minorIssuePending
    //        │                                              └── disputed
    //   Trust/reputation fields on users are server-written only (Cloud Functions).
    function borrowRequestOwner() {
      return signedIn() && request.auth.uid == resource.data.ownerId;
    }

    function borrowRequestBorrower() {
      return signedIn() && request.auth.uid == resource.data.borrowerId;
    }

    function borrowChangedKeysOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function borrowRequiresPayment(data) {
      return (data.hasUsageFee == true && data.usageFeeAmount > 0) ||
        (data.hasDeposit == true && data.depositAmount > 0);
    }

    function borrowPaymentSatisfied(data) {
      return data.paymentStatus == 'completed' || !borrowRequiresPayment(data);
    }

    function ownerCanApproveBorrowRequest() {
      return borrowRequestOwner() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'approved' &&
        borrowChangedKeysOnly([
          'status',
          'paymentStatus',
          'approvedAt',
          'updatedAt',
        ]);
    }

    function ownerCanRejectBorrowRequest() {
      return borrowRequestOwner() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'rejected' &&
        borrowChangedKeysOnly([
          'status',
          'rejectionReason',
          'rejectedAt',
          'updatedAt',
        ]);
    }

    function borrowerCanCancelBorrowRequest() {
      return borrowRequestBorrower() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'cancelled' &&
        borrowChangedKeysOnly(['status', 'updatedAt']);
    }

    function borrowerCanConfirmPickupReady() {
      return borrowRequestBorrower() &&
        resource.data.status == 'pickupReady' &&
        request.resource.data.status == 'active' &&
        borrowChangedKeysOnly([
          'status',
          'handoverConfirmedAt',
          'updatedAt',
        ]);
    }

    function ownerCanConfirmHandover() {
      return borrowRequestOwner() &&
        resource.data.status == 'approved' &&
        borrowPaymentSatisfied(resource.data) &&
        request.resource.data.status == 'pickupReady' &&
        borrowChangedKeysOnly([
          'status',
          'pickupConfirmedAt',
          'handoverCode',
          'itemConditionBefore',
          'updatedAt',
          'handoverProofImageUrl',
        ]);
    }

    function borrowerCanSubmitReturn() {
      return borrowRequestBorrower() &&
        resource.data.status in ['active', 'handedOver'] &&
        request.resource.data.status == 'returnSubmitted' &&
        borrowChangedKeysOnly([
          'status',
          'returnSubmittedAt',
          'returnNotes',
          'returnCode',
          'updatedAt',
          'returnProofImageUrl',
        ]);
    }

    function ownerCanConfirmReturn() {
      return borrowRequestOwner() &&
        resource.data.status == 'returnSubmitted' &&
        request.resource.data.status == 'completed' &&
        request.resource.data.itemConditionAfter == 'sameCondition' &&
        borrowChangedKeysOnly([
          'status',
          'returnConfirmedAt',
          'completedAt',
          'itemConditionAfter',
          'ownerReturnNotes',
          'updatedAt',
          'depositDecision',
          'depositDecisionReason',
          'depositDecidedAt',
        ]);
    }

    function ownerCanReportMinorIssue() {
      return borrowRequestOwner() &&
        resource.data.status == 'returnSubmitted' &&
        resource.data.hasDeposit == true &&
        request.resource.data.status == 'minorIssuePending' &&
        request.resource.data.itemConditionAfter == 'minorDamage' &&
        request.resource.data.minorDeductionAmount is number &&
        request.resource.data.minorDeductionAmount > 0 &&
        request.resource.data.minorDeductionAmount < resource.data.depositAmount &&
        request.resource.data.minorIssueReason is string &&
        request.resource.data.minorIssueReason.size() > 0 &&
        request.resource.data.minorIssueBorrowerDecision == 'pending' &&
        request.resource.data.minorIssueReportedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        borrowChangedKeysOnly([
          'status',
          'itemConditionAfter',
          'ownerReturnNotes',
          'minorDeductionAmount',
          'minorIssueReason',
          'minorIssuePhotoUrl',
          'minorIssueReportedAt',
          'minorIssueBorrowerDecision',
          'minorIssueBorrowerRespondedAt',
          'depositDecision',
          'depositDecisionReason',
          'updatedAt',
        ]);
    }

    function borrowerCanAcceptMinorIssue() {
      return borrowRequestBorrower() &&
        resource.data.status == 'minorIssuePending' &&
        request.resource.data.status == 'completed' &&
        request.resource.data.minorIssueBorrowerDecision == 'accepted' &&
        request.resource.data.minorIssueBorrowerRespondedAt == request.time &&
        request.resource.data.depositDecision == 'partialDeduction' &&
        request.resource.data.depositDecidedAt == request.time &&
        request.resource.data.returnConfirmedAt == request.time &&
        request.resource.data.completedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        borrowChangedKeysOnly([
          'status',
          'minorIssueBorrowerDecision',
          'minorIssueBorrowerRespondedAt',
          'returnConfirmedAt',
          'completedAt',
          'depositDecision',
          'depositDecisionReason',
          'depositDecidedAt',
          'updatedAt',
        ]);
    }

    function borrowerCanDeclineMinorIssue() {
      return borrowRequestBorrower() &&
        resource.data.status == 'minorIssuePending' &&
        request.resource.data.status == 'disputed' &&
        request.resource.data.minorIssueBorrowerDecision == 'declined' &&
        request.resource.data.minorIssueBorrowerRespondedAt == request.time &&
        request.resource.data.disputeReportId is string &&
        request.resource.data.disputeReportId.size() > 0 &&
        request.resource.data.disputeReason is string &&
        request.resource.data.disputeReportedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        borrowChangedKeysOnly([
          'status',
          'minorIssueBorrowerDecision',
          'minorIssueBorrowerRespondedAt',
          'disputeReportId',
          'disputeReason',
          'disputeEvidenceImageUrl',
          'disputeReportedAt',
          'updatedAt',
        ]);
    }

    function ownerCanReportMajorDamage() {
      return borrowRequestOwner() &&
        resource.data.status == 'returnSubmitted' &&
        request.resource.data.status == 'disputed' &&
        request.resource.data.itemConditionAfter in ['majorDamage', 'lost'] &&
        request.resource.data.disputeReportId is string &&
        request.resource.data.disputeReportId.size() > 0 &&
        request.resource.data.disputeReason is string &&
        request.resource.data.disputeReason.size() > 0 &&
        request.resource.data.disputeEvidenceImageUrl is string &&
        request.resource.data.disputeEvidenceImageUrl.size() > 0 &&
        request.resource.data.disputeReportedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        borrowChangedKeysOnly([
          'status',
          'itemConditionAfter',
          'ownerReturnNotes',
          'disputeReportId',
          'disputeReason',
          'disputeEvidenceImageUrl',
          'disputeReportedAt',
          'depositDecision',
          'depositDecisionReason',
          'updatedAt',
        ]);
    }

    function ownerCanSetDepositDecision() {
      return borrowRequestOwner() &&
        resource.data.status == 'completed' &&
        resource.data.paymentProvider != 'stripe' &&
        request.resource.data.status == 'completed' &&
        resource.data.depositDecision == 'pending' &&
        request.resource.data.depositDecision in [
          'returnDeposit',
          'withholdDeposit',
        ] &&
        borrowChangedKeysOnly([
          'depositDecision',
          'depositDecisionReason',
          'depositDecidedAt',
          'updatedAt',
        ]);
    }

    function participantCanSubmitBorrowReview() {
      return signedIn() &&
        resource.data.status == 'completed' &&
        request.resource.data.status == 'completed' &&
        (
          (
            borrowRequestBorrower() &&
            resource.data.borrowerReviewSubmitted != true &&
            request.resource.data.borrowerReviewSubmitted == true &&
            request.resource.data.borrowerReviewSubmittedAt == request.time &&
            borrowChangedKeysOnly([
              'borrowerReviewSubmitted',
              'borrowerReviewSubmittedAt',
              'reviewGraceEndsAt',
              'updatedAt',
            ])
          ) ||
          (
            borrowRequestOwner() &&
            resource.data.ownerReviewSubmitted != true &&
            request.resource.data.ownerReviewSubmitted == true &&
            request.resource.data.ownerReviewSubmittedAt == request.time &&
            borrowChangedKeysOnly([
              'ownerReviewSubmitted',
              'ownerReviewSubmittedAt',
              'reviewGraceEndsAt',
              'updatedAt',
            ])
          )
        ) &&
        request.resource.data.reviewGraceEndsAt is timestamp &&
        request.resource.data.updatedAt == request.time;
    }

    function approxEqual(value, expected) {
      return value is number &&
        expected is number &&
        value >= expected - 0.01 &&
        value <= expected + 0.01;
    }

    function validBorrowRequestCreate(requestId, data) {
      return isVerifiedResident() &&
        data.itemId is string &&
        exists(/databases/$(database)/documents/items/$(data.itemId)) &&
        validBorrowRequestCreateForItem(
          requestId,
          data,
          get(/databases/$(database)/documents/items/$(data.itemId)).data
        );
    }

    function validBorrowRequestCreateForItem(requestId, data, itemData) {
      return data.keys().hasOnly([
          'id',
          'itemId',
          'itemTitle',
          'itemImageUrl',
          'ownerId',
          'ownerName',
          'ownerEmail',
          'borrowerId',
          'borrowerName',
          'borrowerEmail',
          'borrowerPhoneNumber',
          'borrowerVerified',
          'borrowerReputationScore',
          'requestedStartDate',
          'expectedReturnDate',
          'pickupTime',
          'message',
          'status',
          'paymentStatus',
          'paymentCompletedAt',
          'paymentProvider',
          'chatId',
          'handoverCode',
          'returnCode',
          'usageFeeAmount',
          'depositAmount',
          'hasUsageFee',
          'hasDeposit',
          'rentalMode',
          'rentalUnitCount',
          'dailyRateSnapshot',
          'hourlyRateSnapshot',
          'createdAt',
          'updatedAt',
          'approvedAt',
          'rejectedAt',
          'rejectionReason',
          'pickupConfirmedAt',
          'handoverConfirmedAt',
          'returnSubmittedAt',
          'returnConfirmedAt',
          'completedAt',
          'pickupProofImageUrl',
          'handoverProofImageUrl',
          'returnProofImageUrl',
          'itemConditionBefore',
          'itemConditionAfter',
          'returnNotes',
          'ownerReturnNotes',
          'depositDecision',
          'depositDecisionReason',
          'depositDecidedAt',
          'minorDeductionAmount',
          'minorIssueReason',
          'minorIssuePhotoUrl',
          'minorIssueReportedAt',
          'minorIssueBorrowerDecision',
          'minorIssueBorrowerRespondedAt',
          'disputeReportId',
          'disputeReason',
          'disputeEvidenceImageUrl',
          'disputeReportedAt',
          'adminResolution',
          'adminResolutionReason',
          'adminResolvedAt',
          'adminResolvedBy',
        ]) &&
        data.id == requestId &&
        data.borrowerId == request.auth.uid &&
        data.ownerId == itemData.ownerId &&
        data.ownerId != request.auth.uid &&
        data.itemTitle == itemData.title &&
        data.ownerName == itemData.ownerName &&
        data.ownerEmail == itemData.ownerEmail &&
        itemData.status == 'available' &&
        itemData.isArchived != true &&
        data.requestedStartDate is timestamp &&
        data.expectedReturnDate is timestamp &&
        data.requestedStartDate <= data.expectedReturnDate &&
        data.pickupTime is string &&
        data.message is string &&
        data.status == 'pending' &&
        data.paymentStatus == 'pending' &&
        data.paymentCompletedAt == null &&
        data.paymentProvider == '' &&
        data.chatId == '' &&
        data.handoverCode == '' &&
        data.returnCode == '' &&
        data.createdAt == request.time &&
        data.updatedAt == request.time &&
        data.approvedAt == null &&
        data.rejectedAt == null &&
        data.rejectionReason == '' &&
        data.pickupConfirmedAt == null &&
        data.handoverConfirmedAt == null &&
        data.returnSubmittedAt == null &&
        data.returnConfirmedAt == null &&
        data.completedAt == null &&
        data.pickupProofImageUrl == null &&
        data.handoverProofImageUrl == null &&
        data.returnProofImageUrl == null &&
        data.itemConditionBefore == null &&
        data.itemConditionAfter == null &&
        data.returnNotes == '' &&
        data.ownerReturnNotes == '' &&
        data.depositDecisionReason == '' &&
        data.depositDecidedAt == null &&
        validBorrowRequestCreateDisputeDefaults(data) &&
        validBorrowRequestCreateDeposit(data, itemData) &&
        validBorrowRequestCreatePricing(data, itemData);
    }

    function validBorrowRequestCreateDisputeDefaults(data) {
      let keys = data.keys();
      return (!keys.hasAny(['minorDeductionAmount']) || data.minorDeductionAmount == null) &&
        (!keys.hasAny(['minorIssueReason']) || data.minorIssueReason == '') &&
        (!keys.hasAny(['minorIssuePhotoUrl']) || data.minorIssuePhotoUrl == null) &&
        (!keys.hasAny(['minorIssueReportedAt']) || data.minorIssueReportedAt == null) &&
        (!keys.hasAny(['minorIssueBorrowerDecision']) || data.minorIssueBorrowerDecision == 'pending') &&
        (!keys.hasAny(['minorIssueBorrowerRespondedAt']) || data.minorIssueBorrowerRespondedAt == null) &&
        (!keys.hasAny(['disputeReportId']) || data.disputeReportId == '') &&
        (!keys.hasAny(['disputeReason']) || data.disputeReason == '') &&
        (!keys.hasAny(['disputeEvidenceImageUrl']) || data.disputeEvidenceImageUrl == null) &&
        (!keys.hasAny(['disputeReportedAt']) || data.disputeReportedAt == null) &&
        (!keys.hasAny(['adminResolution']) || data.adminResolution == 'pending') &&
        (!keys.hasAny(['adminResolutionReason']) || data.adminResolutionReason == '') &&
        (!keys.hasAny(['adminResolvedAt']) || data.adminResolvedAt == null) &&
        (!keys.hasAny(['adminResolvedBy']) || data.adminResolvedBy == '');
    }

    function validBorrowRequestCreateDeposit(data, itemData) {
      return (
          itemData.hasDeposit != true &&
          data.hasDeposit == false &&
          data.depositAmount == null &&
          data.depositDecision == 'notRequired'
        ) ||
        (
          itemData.hasDeposit == true &&
          data.hasDeposit == true &&
          approxEqual(data.depositAmount, itemData.depositAmount) &&
          data.depositDecision == 'pending'
        );
    }

    function validBorrowRequestCreatePricing(data, itemData) {
      return data.rentalMode in ['daily', 'hourly'] &&
        data.rentalUnitCount is int &&
        data.rentalUnitCount >= 1 &&
        (
          (
            itemData.hasUsageFee != true &&
            data.hasUsageFee == false &&
            data.usageFeeAmount == null &&
            data.dailyRateSnapshot == null &&
            data.hourlyRateSnapshot == null
          ) ||
          (
            itemData.hasUsageFee == true &&
            data.hasUsageFee == true &&
            itemData.feeAmount is number &&
            approxEqual(data.dailyRateSnapshot, itemData.feeAmount) &&
            approxEqual(data.hourlyRateSnapshot, itemData.feeAmount / 8) &&
            (
              (
                data.rentalMode == 'daily' &&
                approxEqual(
                  data.usageFeeAmount,
                  itemData.feeAmount * data.rentalUnitCount
                )
              ) ||
              (
                data.rentalMode == 'hourly' &&
                data.rentalUnitCount >= 8 &&
                approxEqual(data.usageFeeAmount, itemData.feeAmount)
              ) ||
              (
                data.rentalMode == 'hourly' &&
                data.rentalUnitCount < 8 &&
                approxEqual(
                  data.usageFeeAmount,
                  (itemData.feeAmount / 8) * data.rentalUnitCount
                )
              )
            )
          )
        );
    }

    function validBorrowRequestUpdate() {
      return ownerCanApproveBorrowRequest() ||
        ownerCanRejectBorrowRequest() ||
        borrowerCanCancelBorrowRequest() ||
        borrowerCanConfirmPickupReady() ||
        ownerCanConfirmHandover() ||
        borrowerCanSubmitReturn() ||
        ownerCanConfirmReturn() ||
        ownerCanReportMinorIssue() ||
        borrowerCanAcceptMinorIssue() ||
        borrowerCanDeclineMinorIssue() ||
        ownerCanReportMajorDamage() ||
        ownerCanSetDepositDecision() ||
        participantCanSubmitBorrowReview();
    }

// --- User profile update helpers ---
    function ownSafeUserUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
        'firstName',
        'lastName',
        'fullName',
        'email',
        'pendingEmail',
        'phoneNumber',
        'phoneVerified',
        'emailVerified',
        'profileImageUrl',
        'communityId',
        'communityName',
        'unitNumber',
        'cameraEnabled',
        'cameraPermissionStatus',
        'photosDocumentsEnabled',
        'photosDocumentsPermissionStatus',
        'notificationEnabled',
        'notificationPermissionStatus',
        'fcmToken',
        'locationVerified',
        'locationVerificationStatus',
        'locationVerifiedCommunityName',
        'updatedAt',
      ]);
    }

    function ownerCanChangeCommunityWithVerificationReset() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasAll(['communityId', 'communityName']) &&
        changed.hasOnly([
          'communityId',
          'communityName',
          'verificationStatus',
          'locationVerified',
          'locationVerificationStatus',
          'locationVerifiedCommunityName',
          'updatedAt',
        ]) &&
        resource.data.communityId != request.resource.data.communityId &&
        request.resource.data.verificationStatus == 'pending' &&
        request.resource.data.locationVerified == false &&
        request.resource.data.locationVerificationStatus == 'pending' &&
        request.resource.data.locationVerifiedCommunityName == '' &&
        request.resource.data.updatedAt == request.time;
    }

// --- Borrow completion counter helpers ---
    function validBorrowCompletionCounterUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let requestId = request.resource.data.lastCompletedBorrowRequestId;
      let requestPath = /databases/$(database)/documents/borrowRequests/$(requestId);
      let borrowData = getAfter(requestPath).data;
      return signedIn() &&
        changed.hasOnly([
          'completedBorrowings',
          'completedLendings',
          'lastCompletedBorrowRequestId',
          'updatedAt',
        ]) &&
        requestId is string &&
        existsAfter(requestPath) &&
        borrowData.status == 'completed' &&
        borrowData.completedAt == request.time &&
        borrowData.returnConfirmedAt == request.time &&
        request.auth.uid in [borrowData.ownerId, borrowData.borrowerId] &&
        request.resource.data.updatedAt == request.time &&
        (
          (
            borrowData.ownerId == userId &&
            request.resource.data.completedLendings ==
              resource.data.completedLendings + 1 &&
            request.resource.data.completedBorrowings ==
              resource.data.completedBorrowings
          ) ||
          (
            borrowData.borrowerId == userId &&
            request.resource.data.completedBorrowings ==
              resource.data.completedBorrowings + 1 &&
            request.resource.data.completedLendings ==
              resource.data.completedLendings
          )
        );
    }

    function validBorrowItemCompletionUpdate(itemId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let requestId = request.resource.data.lastCompletedBorrowRequestId;
      let requestPath = /databases/$(database)/documents/borrowRequests/$(requestId);
      let borrowData = getAfter(requestPath).data;
      return signedIn() &&
        changed.hasOnly([
          'status',
          'lastCompletedBorrowRequestId',
          'updatedAt',
        ]) &&
        requestId is string &&
        existsAfter(requestPath) &&
        borrowData.itemId == itemId &&
        borrowData.status == 'completed' &&
        borrowData.completedAt == request.time &&
        request.auth.uid in [borrowData.ownerId, borrowData.borrowerId] &&
        request.resource.data.status == 'available' &&
        request.resource.data.updatedAt == request.time;
    }

// --- Item listing helpers ---
    function itemOwner() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function itemChangedKeysOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function itemOwnerSnapshotUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.ownerName == resource.data.ownerName &&
        request.resource.data.ownerEmail == resource.data.ownerEmail &&
        request.resource.data.ownerPhotoUrl == resource.data.ownerPhotoUrl &&
        request.resource.data.ownerVerified == resource.data.ownerVerified &&
        request.resource.data.ownerReputationScore == resource.data.ownerReputationScore &&
        request.resource.data.communityId == resource.data.communityId &&
        request.resource.data.communityName == resource.data.communityName &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (
          (!('lastCompletedBorrowRequestId' in resource.data) &&
            !('lastCompletedBorrowRequestId' in request.resource.data)) ||
          request.resource.data.lastCompletedBorrowRequestId ==
            resource.data.lastCompletedBorrowRequestId
        );
    }

    function itemIsEditableListing() {
      return resource.data.status == 'available' &&
        resource.data.isArchived != true;
    }

    function ownerSafeItemUpdate() {
      return itemOwner() &&
        itemIsEditableListing() &&
        request.resource.data.status == 'available' &&
        request.resource.data.isArchived == false &&
        itemOwnerSnapshotUnchanged() &&
        itemChangedKeysOnly([
          'title',
          'description',
          'category',
          'condition',
          'lendingType',
          'hasUsageFee',
          'feeAmount',
          'hasDeposit',
          'depositAmount',
          'pickupInstructions',
          'imageUrls',
          'updatedAt',
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.description is string &&
        request.resource.data.category is string &&
        request.resource.data.condition is string &&
        request.resource.data.pickupInstructions is string &&
        request.resource.data.imageUrls is list;
    }

    function ownerCanArchiveItem() {
      return itemOwner() &&
        itemIsEditableListing() &&
        request.resource.data.isArchived == true &&
        request.resource.data.status == 'archived' &&
        itemOwnerSnapshotUnchanged() &&
        itemChangedKeysOnly([
          'isArchived',
          'status',
          'updatedAt',
        ]);
    }

    function itemIsArchivedListing() {
      return resource.data.status == 'archived' ||
        resource.data.isArchived == true;
    }

    function ownerCanUnarchiveItem() {
      return itemOwner() &&
        itemIsArchivedListing() &&
        request.resource.data.isArchived != true &&
        request.resource.data.status == 'available' &&
        itemOwnerSnapshotUnchanged() &&
        itemChangedKeysOnly([
          'isArchived',
          'status',
          'updatedAt',
        ]);
    }

    function ownerCanMarkItemUnavailable() {
      return itemOwner() &&
        itemIsEditableListing() &&
        request.resource.data.status == 'unavailable' &&
        request.resource.data.isArchived == resource.data.isArchived &&
        itemOwnerSnapshotUnchanged() &&
        itemChangedKeysOnly([
          'status',
          'updatedAt',
        ]);
    }

    function validItemCreate() {
      let data = request.resource.data;
      return isVerifiedResident() &&
        data.ownerId == request.auth.uid &&
        data.status == 'available' &&
        data.isArchived == false &&
        data.communityId == myUserDoc().data.communityId &&
        data.communityName == myUserDoc().data.communityName &&
        data.title is string &&
        data.description is string &&
        data.category is string &&
        data.condition is string &&
        data.pickupInstructions is string &&
        data.imageUrls is list &&
        data.imageUrls.size() > 0 &&
        data.lendingType is string &&
        data.hasUsageFee is bool &&
        data.hasDeposit is bool &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function canReadMarketplaceItem() {
      return (
          isAdmin() &&
          (isSystemAdmin() || adminCanAccessCommunity(resource.data.communityId))
        ) ||
        itemOwner() ||
        (
          hasProfile() &&
          resource.data.communityId is string &&
          resource.data.communityId == myUserDoc().data.communityId
        );
    }

// --- Service listing helpers ---
    function serviceProvider() {
      return signedIn() && resource.data.providerId == request.auth.uid;
    }

    function serviceChangedKeysOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function serviceProviderSnapshotUnchanged() {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.providerId == resource.data.providerId &&
        request.resource.data.providerName == resource.data.providerName &&
        request.resource.data.providerEmail == resource.data.providerEmail &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function serviceListingFieldsUnchanged() {
      return request.resource.data.title == resource.data.title &&
        request.resource.data.description == resource.data.description &&
        request.resource.data.category == resource.data.category &&
        request.resource.data.priceType == resource.data.priceType &&
        request.resource.data.priceAmount == resource.data.priceAmount &&
        request.resource.data.availability == resource.data.availability;
    }

    function serviceIsEditableListing() {
      return resource.data.status == 'active';
    }

    function providerSafeServiceUpdate() {
      return serviceProvider() &&
        serviceIsEditableListing() &&
        request.resource.data.status == 'active' &&
        serviceProviderSnapshotUnchanged() &&
        serviceChangedKeysOnly([
          'title',
          'description',
          'category',
          'priceType',
          'priceAmount',
          'availability',
          'updatedAt',
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.description is string &&
        request.resource.data.category is string &&
        request.resource.data.priceType is string &&
        request.resource.data.availability is string;
    }

    function providerCanSetServiceStatus() {
      return serviceProvider() &&
        serviceProviderSnapshotUnchanged() &&
        serviceListingFieldsUnchanged() &&
        serviceChangedKeysOnly(['status', 'updatedAt']) &&
        request.resource.data.status in ['active', 'inactive', 'archived'];
    }

    function validServiceCreate(serviceId) {
      let data = request.resource.data;
      return isVerifiedResident() &&
        data.providerId == request.auth.uid &&
        data.status == 'active' &&
        data.id == serviceId &&
        data.title is string &&
        data.description is string &&
        data.category is string &&
        data.priceType is string &&
        data.availability is string &&
        data.providerName is string &&
        data.providerEmail is string &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function serviceListingProviderCommunityId() {
      return userDoc(resource.data.providerId).data.communityId;
    }

    function canReadServiceListing() {
      return (
          isAdmin() &&
          exists(/databases/$(database)/documents/users/$(resource.data.providerId)) &&
          (isSystemAdmin() || adminCanAccessCommunity(serviceListingProviderCommunityId()))
        ) ||
        serviceProvider() ||
        (
          hasProfile() &&
          exists(/databases/$(database)/documents/users/$(resource.data.providerId)) &&
          serviceListingProviderCommunityId() == myUserDoc().data.communityId
        );
    }

    function serviceRequestChangedKeysOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function serviceRequestSnapshotUnchanged() {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.serviceId == resource.data.serviceId &&
        request.resource.data.serviceTitle == resource.data.serviceTitle &&
        request.resource.data.providerId == resource.data.providerId &&
        request.resource.data.providerName == resource.data.providerName &&
        request.resource.data.requesterId == resource.data.requesterId &&
        request.resource.data.requesterName == resource.data.requesterName &&
        request.resource.data.message == resource.data.message &&
        request.resource.data.preferredDate == resource.data.preferredDate &&
        request.resource.data.preferredTime == resource.data.preferredTime &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function serviceRequestProvider() {
      return signedIn() && resource.data.providerId == request.auth.uid;
    }

    function serviceRequestRequester() {
      return signedIn() && resource.data.requesterId == request.auth.uid;
    }

    function providerCanAcceptServiceRequest() {
      return serviceRequestProvider() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        serviceRequestSnapshotUnchanged() &&
        serviceRequestChangedKeysOnly(['status', 'updatedAt']);
    }

    function providerCanRejectServiceRequest() {
      return serviceRequestProvider() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'rejected' &&
        serviceRequestSnapshotUnchanged() &&
        serviceRequestChangedKeysOnly(['status', 'updatedAt']);
    }

    function providerCanCompleteServiceRequest() {
      return serviceRequestProvider() &&
        resource.data.status == 'accepted' &&
        request.resource.data.status == 'completed' &&
        serviceRequestSnapshotUnchanged() &&
        serviceRequestChangedKeysOnly(['status', 'updatedAt']);
    }

    function requesterCanCancelServiceRequest() {
      return serviceRequestRequester() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'cancelled' &&
        serviceRequestSnapshotUnchanged() &&
        serviceRequestChangedKeysOnly(['status', 'updatedAt']);
    }

    function validServiceRequestUpdate() {
      return providerCanAcceptServiceRequest() ||
        providerCanRejectServiceRequest() ||
        providerCanCompleteServiceRequest() ||
        requesterCanCancelServiceRequest();
    }

    function validServiceRequestCreate(requestId) {
      let data = request.resource.data;
      return isVerifiedResident() &&
        data.id == requestId &&
        data.requesterId == request.auth.uid &&
        data.serviceId is string &&
        exists(/databases/$(database)/documents/services/$(data.serviceId)) &&
        exists(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/services/$(data.serviceId)).data.providerId)) &&
        get(/databases/$(database)/documents/services/$(data.serviceId)).data.status == 'active' &&
        get(/databases/$(database)/documents/services/$(data.serviceId)).data.providerId != request.auth.uid &&
        data.providerId == get(/databases/$(database)/documents/services/$(data.serviceId)).data.providerId &&
        data.serviceTitle == get(/databases/$(database)/documents/services/$(data.serviceId)).data.title &&
        data.providerName == get(/databases/$(database)/documents/services/$(data.serviceId)).data.providerName &&
        userDoc(data.providerId).data.communityId == myUserDoc().data.communityId &&
        data.requesterName is string &&
        data.message is string &&
        data.preferredDate is timestamp &&
        data.preferredTime is string &&
        data.status == 'pending' &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

// --- Review and profile image helpers ---
    function ownProfileImageUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
        'profileImageUrl',
        'updatedAt',
      ]) &&
      request.resource.data.profileImageUrl is string;
    }

    function completedBorrowRequestForReview(data) {
      return data.borrowRequestId is string &&
        exists(/databases/$(database)/documents/borrowRequests/$(data.borrowRequestId)) &&
        get(/databases/$(database)/documents/borrowRequests/$(data.borrowRequestId)).data.status == 'completed';
    }

    function validBorrowerToOwnerReview(data, borrowData) {
      return data.role == 'borrowerToOwner' &&
        borrowData.borrowerReviewSubmitted != true &&
        data.reviewerId == borrowData.borrowerId &&
        data.revieweeId == borrowData.ownerId;
    }

    function validOwnerToBorrowerReview(data, borrowData) {
      return data.role == 'ownerToBorrower' &&
        borrowData.ownerReviewSubmitted != true &&
        data.reviewerId == borrowData.ownerId &&
        data.revieweeId == borrowData.borrowerId;
    }

    function validCompletedBorrowReview(data) {
      let borrowData = get(/databases/$(database)/documents/borrowRequests/$(data.borrowRequestId)).data;
      return completedBorrowRequestForReview(data) &&
        data.itemId == borrowData.itemId &&
        (
          validBorrowerToOwnerReview(data, borrowData) ||
          validOwnerToBorrowerReview(data, borrowData)
        );
    }

    function validReviewCreate(data) {
      return signedIn() &&
        data.keys().hasOnly([
          'borrowRequestId',
          'itemId',
          'reviewerId',
          'reviewerName',
          'revieweeId',
          'revieweeName',
          'rating',
          'comment',
          'role',
          'visible',
          'status',
          'publishAfter',
          'publishedAt',
          'createdAt',
        ]) &&
        data.reviewerId == request.auth.uid &&
        data.revieweeId != request.auth.uid &&
        data.reviewerName is string &&
        data.revieweeName is string &&
        data.comment is string &&
        data.rating is int &&
        data.rating >= 1 &&
        data.rating <= 5 &&
        data.role in ['borrowerToOwner', 'ownerToBorrower'] &&
        data.visible == false &&
        data.status == 'hidden' &&
        data.publishAfter is timestamp &&
        data.publishedAt == null &&
        data.createdAt == request.time &&
        validCompletedBorrowReview(data);
    }

    function canReadPublicProfile(data) {
      return isVerifiedResident() &&
        data.role == 'resident' &&
        hasVerifiedResidentStatus(data.verificationStatus) &&
        data.communityId == myUserDoc().data.communityId;
    }

// --- users collection ---
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isSystemAdmin() ||
        (isAdmin() && resource.data.communityId == adminCommunityId());

      allow create: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.role == 'resident' &&
        request.resource.data.verificationStatus == 'pending';

      // Trust/reputation fields are updated only by Cloud Functions (Admin SDK)
      // or manually by admins — never by resident clients.
      allow update: if isAdmin() ||
        (isOwner(uid) && ownSafeUserUpdate()) ||
        (isOwner(uid) && ownerCanChangeCommunityWithVerificationReset());
      allow delete: if isAdmin();
    }

    // Community-visible resident fields only. Synced from /users by Cloud Functions.
    match /publicProfiles/{uid} {
      allow get: if isOwner(uid) ||
        isAdmin() ||
        canReadPublicProfile(resource.data);
      allow list: if isVerifiedResident() &&
        resource.data.communityId == myUserDoc().data.communityId;
      allow create, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if isOwner(uid) || isSystemAdmin();
      allow list: if isSystemAdmin();
      allow create, delete: if isSystemAdmin();
      allow update: if isSystemAdmin() ||
        (isOwner(uid) && ownProfileImageUpdate());
    }

    match /communities/{communityId} {
      // Community names and boundaries are needed before a resident profile exists
      // during registration and location verification. Keep writes admin-only.
      allow get, list: if true;
      allow write: if isAdmin();
    }

// --- verificationRequests collection ---
    match /verificationRequests/{requestId} {
      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          isSystemAdmin() ||
          adminCanAccessCommunity(resource.data.communityId)
        );

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'submitted';

      allow update: if isAdmin() ||
        (
          signedIn() &&
          resource.data.userId == request.auth.uid &&
          (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'cancelledAt',
                'cancelledBy',
              ]) &&
              request.resource.data.status == 'cancelled' &&
              request.resource.data.cancelledBy == request.auth.uid
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'documentUrl',
                'fileUrl',
                'updatedAt',
              ]) &&
              request.resource.data.userId == resource.data.userId &&
              request.resource.data.status == resource.data.status &&
              request.resource.data.storagePath == resource.data.storagePath
            )
          )
        );

      allow delete: if isAdmin();
    }

// --- items collection (marketplace) ---
    match /items/{itemId} {
      allow read: if canReadMarketplaceItem();
      allow create: if validItemCreate();
      allow update: if isAdmin() ||
        ownerCanMarkItemUnavailable() ||
        ownerSafeItemUpdate() ||
        ownerCanArchiveItem() ||
        ownerCanUnarchiveItem();
      allow delete: if isAdmin();
    }

    match /borrowRequests/{requestId} {
      allow read: if isAdmin() ||
        (
          signedIn() &&
          (resource.data.borrowerId == request.auth.uid ||
           resource.data.ownerId == request.auth.uid)
        );

      allow create: if validBorrowRequestCreate(requestId, request.resource.data);

      allow update: if isAdmin() || validBorrowRequestUpdate();
    }

    match /services/{serviceId} {
      allow read: if isAdmin() || canReadServiceListing();
      allow create: if validServiceCreate(serviceId);
      allow update: if isAdmin() ||
        providerSafeServiceUpdate() ||
        providerCanSetServiceStatus();
      allow delete: if isAdmin();
    }

    match /serviceRequests/{requestId} {
      allow read: if isAdmin() ||
        (
          signedIn() &&
          (resource.data.requesterId == request.auth.uid ||
           resource.data.providerId == request.auth.uid)
        );

      allow create: if validServiceRequestCreate(requestId);

      allow update: if isAdmin() || validServiceRequestUpdate();
    }

// --- reviews and reports collections ---
    match /reviews/{reviewId} {
      allow get: if signedIn() &&
        (
          reviewId.matches('.*_' + request.auth.uid) ||
          isAdmin() ||
          resource.data.visible == true
        );
      allow list: if signedIn() &&
        (
          isAdmin() ||
          resource.data.visible == true ||
          resource.data.reviewerId == request.auth.uid
        );
      allow create: if validReviewCreate(request.resource.data);
      // Publishing is handled server-side by Cloud Functions.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isSystemAdmin() ||
        adminCanAccessCommunity(resource.data.communityId) ||
        (isAdmin() && !resource.data.keys().hasAny(['communityId']));

      allow create: if hasProfile() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.communityId == myUserDoc().data.communityId &&
        request.resource.data.communityName == myUserDoc().data.communityName;

      allow update, delete: if isSystemAdmin() ||
        adminCanAccessCommunity(resource.data.communityId) ||
        (isAdmin() && !resource.data.keys().hasAny(['communityId']));
    }

    match /transactions/{transactionId} {
      allow read: if isSystemAdmin() ||
        adminCanAccessCommunity(resource.data.communityId);
      allow create, update, delete: if isSystemAdmin();
    }

// --- connections collection ---
    match /connections/{connectionId} {
      allow get: if connectionParticipant(resource.data) ||
        adminCanAccessCommunity(resource.data.communityId);

      allow list: if connectionParticipantQuery(resource.data) ||
        connectionOwnedByCurrentUser(resource.data) ||
        adminCanAccessCommunity(resource.data.communityId);

      allow create: if isVerifiedResident() &&
        request.resource.data.keys().hasOnly([
          'fromUserId',
          'toUserId',
          'participants',
          'communityId',
          'status',
          'createdAt',
          'updatedAt',
        ]) &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId != request.auth.uid &&
        request.resource.data.communityId == myUserDoc().data.communityId &&
        request.resource.data.status == 'pending' &&
        isValidConnectionParticipants(request.resource.data) &&
        targetUserCanConnect(request.resource.data);

      allow update: if recipientCanResolvePendingRequest() ||
        senderCanRefreshPendingRequest();

      allow delete: if participantCanDeleteConnection() ||
        adminCanAccessCommunity(resource.data.communityId);
    }

// --- chats collection ---
    match /chats/{chatId} {
      allow get: if chatParticipant(resource.data) ||
        (isVerifiedResident() &&
          !exists(/databases/$(database)/documents/chats/$(chatId)));
      allow list: if isVerifiedResident();
      allow create: if validChatCreate(request.resource.data);
      allow update: if validChatUpdate();
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if chatParticipantById(chatId);
        allow create: if validChatMessageCreate(chatId, request.resource.data);
        allow update: if validChatMessageReadUpdate(chatId) ||
          validChatMessageDeleteForUser(chatId);
        allow delete: if false;
      }
    }

// --- notifications collection ---
    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn() &&
        resource.data.userId == request.auth.uid;
      // In-app notifications are created by Cloud Functions or admins.
      allow create: if isAdmin();
    }

// --- Community post validation helpers ---
    function validCommunityPostType(type) {
      return type in ['news', 'announcement', 'warning', 'event', 'maintenance'];
    }

    function validCommunityPostImageUrl(data) {
      return !('imageUrl' in data) ||
        (data.imageUrl is string && data.imageUrl.size() <= 2048);
    }

    function validCommunityPostCreate(postId) {
      return isAdmin() &&
        adminCanAccessCommunity(request.resource.data.communityId) &&
        request.resource.data.communityId is string &&
        request.resource.data.communityId != '' &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.authorName is string &&
        request.resource.data.audience is string &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        validCommunityPostType(request.resource.data.type) &&
        request.resource.data.status == 'draft' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        validCommunityPostImageUrl(request.resource.data) &&
        (
          !('id' in request.resource.data) ||
          request.resource.data.id == postId
        );
    }

    function communityPostDraftUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.status == 'draft' &&
        changed.hasOnly([
          'title',
          'body',
          'type',
          'audience',
          'imageUrl',
          'updatedAt',
        ]) &&
        request.resource.data.status == 'draft' &&
        request.resource.data.communityId == resource.data.communityId &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.authorName == resource.data.authorName &&
        request.resource.data.createdAt == resource.data.createdAt &&
        validCommunityPostType(request.resource.data.type) &&
        validCommunityPostImageUrl(request.resource.data);
    }

    function communityPostPublishUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.status == 'draft' &&
        request.resource.data.status == 'published' &&
        changed.hasOnly(['status', 'publishedAt', 'updatedAt']) &&
        request.resource.data.publishedAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function communityPostCoverReplaceUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.status == 'published' &&
        request.resource.data.status == 'published' &&
        changed.hasOnly(['imageUrl', 'updatedAt']) &&
        request.resource.data.communityId == resource.data.communityId &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.authorName == resource.data.authorName &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.body == resource.data.body &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.audience == resource.data.audience &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.publishedAt == resource.data.publishedAt &&
        validCommunityPostImageUrl(request.resource.data);
    }

    function validCommunityPostUpdate() {
      return communityPostDraftUpdate() ||
        communityPostPublishUpdate() ||
        communityPostCoverReplaceUpdate();
    }

// --- communityPosts and default deny ---
    match /communityPosts/{postId} {
      allow read: if signedIn() && (
        adminCanAccessCommunity(resource.data.communityId) ||
        (
          isVerifiedResident() &&
          resource.data.communityId == myUserDoc().data.communityId &&
          resource.data.status == 'published'
        )
      );
      allow create: if validCommunityPostCreate(postId);
      allow update: if isAdmin() &&
        resource.data.authorId == request.auth.uid &&
        adminCanAccessCommunity(resource.data.communityId) &&
        validCommunityPostUpdate();
      allow delete: if isAdmin() &&
        adminCanAccessCommunity(resource.data.communityId);
    }

    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() ||
        (
          signedIn() &&
          (resource.data.payerId == request.auth.uid ||
           resource.data.receiverId == request.auth.uid)
        );
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid}/paymentMethods/{paymentMethodId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
