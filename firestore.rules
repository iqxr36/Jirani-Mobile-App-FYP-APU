rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function myAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasAdminProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidAdminDoc(data) {
      return data.isActive != false &&
        data.role in ['communityAdmin', 'systemAdmin'];
    }

    function isAdmin() {
      return hasAdminProfile() && isValidAdminDoc(myAdminDoc().data);
    }

    function isSystemAdmin() {
      return hasAdminProfile() &&
        isValidAdminDoc(myAdminDoc().data) &&
        myAdminDoc().data.role == 'systemAdmin';
    }

    function adminCommunityId() {
      return myAdminDoc().data.communityId;
    }

    function adminCanAccessCommunity(communityId) {
      return isSystemAdmin() ||
        (
          isAdmin() &&
          communityId is string &&
          communityId != '' &&
          communityId == adminCommunityId()
        );
    }

    function hasVerifiedResidentStatus(status) {
      return status in ['verified', 'approved'];
    }

    function isVerifiedResident() {
      return hasProfile() &&
        hasVerifiedResidentStatus(myUserDoc().data.verificationStatus);
    }

    function isVerifiedResidentData(data) {
      return data.role == 'resident' &&
        hasVerifiedResidentStatus(data.verificationStatus);
    }

    function canReadCommunityResident(data) {
      return isVerifiedResident() &&
        isVerifiedResidentData(data) &&
        data.communityId == myUserDoc().data.communityId;
    }

    function isValidConnectionParticipants(data) {
      return data.participants is list &&
        data.participants.size() == 2 &&
        data.fromUserId in data.participants &&
        data.toUserId in data.participants;
    }

    function connectionParticipant(data) {
      return signedIn() &&
        data.participants is list &&
        request.auth.uid in data.participants;
    }

    function connectionParticipantQuery(data) {
      return signedIn() &&
        request.auth.uid in data.participants;
    }

    function connectionOwnedByCurrentUser(data) {
      return signedIn() &&
        (data.fromUserId == request.auth.uid || data.toUserId == request.auth.uid);
    }

    function targetUserCanConnect(data) {
      return data.toUserId is string &&
        exists(/databases/$(database)/documents/users/$(data.toUserId)) &&
        isVerifiedResidentData(userDoc(data.toUserId).data) &&
        userDoc(data.toUserId).data.communityId == myUserDoc().data.communityId;
    }

    function preservesConnectionIdentity() {
      return request.resource.data.fromUserId == resource.data.fromUserId &&
        request.resource.data.toUserId == resource.data.toUserId &&
        request.resource.data.communityId == resource.data.communityId &&
        request.resource.data.participants == resource.data.participants &&
        isValidConnectionParticipants(request.resource.data);
    }

    function senderCanRefreshPendingRequest() {
      return signedIn() &&
        request.auth.uid == resource.data.fromUserId &&
        resource.data.status in ['pending', 'declined'] &&
        request.resource.data.keys().hasOnly([
          'fromUserId',
          'toUserId',
          'participants',
          'communityId',
          'status',
          'createdAt',
          'updatedAt',
        ]) &&
        preservesConnectionIdentity() &&
        request.resource.data.status == 'pending';
    }

    function recipientCanResolvePendingRequest() {
      return signedIn() &&
        request.auth.uid == resource.data.toUserId &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
        ]) &&
        request.resource.data.status in ['accepted', 'declined'];
    }

    function participantCanDeleteConnection() {
      return connectionParticipant(resource.data) &&
        (
          resource.data.status == 'accepted' ||
          (
            resource.data.status == 'pending' &&
            request.auth.uid == resource.data.fromUserId
          )
        );
    }

    function isValidChatParticipants(data) {
      return data.participantIds is list &&
        data.participantIds.size() == 2 &&
        request.auth.uid in data.participantIds;
    }

    function chatParticipant(data) {
      return signedIn() &&
        (
          (
            data.participantIds is list &&
            request.auth.uid in data.participantIds
          ) ||
          (
            data.participantLookup is map &&
            data.participantLookup[request.auth.uid] == true
          )
        );
    }

    function chatParticipantLookup(data) {
      return signedIn() &&
        data.participantLookup is map &&
        data.participantLookup[request.auth.uid] == true;
    }

    function chatParticipantById(chatId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
    }

    function chatParticipantByIdAfter(chatId) {
      return signedIn() &&
        request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
    }

    function chatParticipantsAreVerifiedResidents(data) {
      return isValidChatParticipants(data) &&
        exists(/databases/$(database)/documents/users/$(data.participantIds[0])) &&
        exists(/databases/$(database)/documents/users/$(data.participantIds[1])) &&
        isVerifiedResidentData(userDoc(data.participantIds[0]).data) &&
        isVerifiedResidentData(userDoc(data.participantIds[1]).data) &&
        userDoc(data.participantIds[0]).data.communityId == myUserDoc().data.communityId &&
        userDoc(data.participantIds[1]).data.communityId == myUserDoc().data.communityId &&
        data.communityId == myUserDoc().data.communityId;
    }

    function validChatParticipantLookup(data) {
      return data.participantLookup is map &&
        data.participantLookup[data.participantIds[0]] == true &&
        data.participantLookup[data.participantIds[1]] == true;
    }

    function validChatCreate(data) {
      return isVerifiedResident() &&
        data.keys().hasOnly([
          'participantIds',
          'communityId',
          'connectionId',
          'participantNames',
          'participantImageUrls',
          'participantLookup',
          'lastMessageText',
          'lastMessageType',
          'lastMessageAt',
          'lastSenderId',
          'unreadCounts',
          'deletedFor',
          'createdAt',
          'updatedAt',
        ]) &&
        chatParticipantsAreVerifiedResidents(data) &&
        validChatParticipantLookup(data) &&
        data.deletedFor is list &&
        data.deletedFor.size() == 0;
    }

    function validChatUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return chatParticipant(resource.data) &&
        !changed.hasAny([
          'participantIds',
          'communityId',
          'connectionId',
          'createdAt',
        ]);
    }

    function chatBelongsToMyCommunity(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.communityId ==
        myUserDoc().data.communityId;
    }

    function validChatMessageCreate(chatId, data) {
      return isVerifiedResident() &&
        chatParticipantById(chatId) &&
        chatBelongsToMyCommunity(chatId) &&
        data.chatId == chatId &&
        data.senderId == request.auth.uid;
    }

    function validChatMessageReadUpdate(chatId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return chatParticipantByIdAfter(chatId) &&
        changed.hasOnly(['readBy']) &&
        request.auth.uid in request.resource.data.readBy;
    }

    function borrowRequestOwner() {
      return signedIn() && request.auth.uid == resource.data.ownerId;
    }

    function borrowRequestBorrower() {
      return signedIn() && request.auth.uid == resource.data.borrowerId;
    }

    function borrowChangedKeysOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function ownerCanApproveBorrowRequest() {
      return borrowRequestOwner() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'approved' &&
        borrowChangedKeysOnly([
          'status',
          'paymentStatus',
          'approvedAt',
          'updatedAt',
        ]);
    }

    function ownerCanRejectBorrowRequest() {
      return borrowRequestOwner() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'rejected' &&
        borrowChangedKeysOnly([
          'status',
          'rejectionReason',
          'rejectedAt',
          'updatedAt',
        ]);
    }

    function borrowerCanCancelBorrowRequest() {
      return borrowRequestBorrower() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'cancelled' &&
        borrowChangedKeysOnly(['status', 'updatedAt']);
    }

    function borrowerCanCompletePayment() {
      return borrowRequestBorrower() &&
        resource.data.status == 'approved' &&
        request.resource.data.status == 'approved' &&
        request.resource.data.paymentStatus == 'completed' &&
        borrowChangedKeysOnly([
          'paymentStatus',
          'paymentCompletedAt',
          'paymentProvider',
          'chatId',
          'handoverCode',
          'returnCode',
          'updatedAt',
        ]);
    }

    function borrowerCanConfirmPickupReady() {
      return borrowRequestBorrower() &&
        resource.data.status == 'approved' &&
        request.resource.data.status == 'pickupReady' &&
        borrowChangedKeysOnly([
          'status',
          'pickupConfirmedAt',
          'updatedAt',
          'pickupProofImageUrl',
        ]);
    }

    function ownerCanConfirmHandover() {
      return borrowRequestOwner() &&
        resource.data.status == 'pickupReady' &&
        request.resource.data.status == 'active' &&
        borrowChangedKeysOnly([
          'status',
          'handoverConfirmedAt',
          'itemConditionBefore',
          'updatedAt',
          'handoverProofImageUrl',
        ]);
    }

    function borrowerCanSubmitReturn() {
      return borrowRequestBorrower() &&
        resource.data.status in ['active', 'handedOver'] &&
        request.resource.data.status == 'returnSubmitted' &&
        borrowChangedKeysOnly([
          'status',
          'returnSubmittedAt',
          'returnNotes',
          'updatedAt',
          'returnProofImageUrl',
        ]);
    }

    function ownerCanConfirmReturn() {
      return borrowRequestOwner() &&
        resource.data.status == 'returnSubmitted' &&
        request.resource.data.status == 'completed' &&
        borrowChangedKeysOnly([
          'status',
          'returnConfirmedAt',
          'completedAt',
          'itemConditionAfter',
          'ownerReturnNotes',
          'updatedAt',
          'depositDecision',
          'depositDecisionReason',
          'depositDecidedAt',
        ]);
    }

    function ownerCanSetDepositDecision() {
      return borrowRequestOwner() &&
        resource.data.status == 'completed' &&
        request.resource.data.status == 'completed' &&
        resource.data.depositDecision == 'pending' &&
        request.resource.data.depositDecision in [
          'returnDeposit',
          'withholdDeposit',
        ] &&
        borrowChangedKeysOnly([
          'depositDecision',
          'depositDecisionReason',
          'depositDecidedAt',
          'updatedAt',
        ]);
    }

    function validBorrowRequestUpdate() {
      return ownerCanApproveBorrowRequest() ||
        ownerCanRejectBorrowRequest() ||
        borrowerCanCancelBorrowRequest() ||
        borrowerCanCompletePayment() ||
        borrowerCanConfirmPickupReady() ||
        ownerCanConfirmHandover() ||
        borrowerCanSubmitReturn() ||
        ownerCanConfirmReturn() ||
        ownerCanSetDepositDecision();
    }

    function ownSafeUserUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
        'firstName',
        'lastName',
        'fullName',
        'phoneNumber',
        'phoneVerified',
        'emailVerified',
        'profileImageUrl',
        'communityId',
        'communityName',
        'unitNumber',
        'cameraEnabled',
        'cameraPermissionStatus',
        'photosDocumentsEnabled',
        'photosDocumentsPermissionStatus',
        'notificationEnabled',
        'notificationPermissionStatus',
        'fcmToken',
        'locationVerified',
        'locationVerificationStatus',
        'locationVerifiedCommunityName',
        'verificationStatus',
        'updatedAt',
      ]) &&
      (
        !changed.hasAny(['verificationStatus']) ||
        request.resource.data.verificationStatus in ['pending', 'submitted']
      );
    }

    function ownProfileImageUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
        'profileImageUrl',
        'updatedAt',
      ]) &&
      request.resource.data.profileImageUrl is string;
    }

    function completedBorrowRequestForReview(data) {
      return data.borrowRequestId is string &&
        exists(/databases/$(database)/documents/borrowRequests/$(data.borrowRequestId)) &&
        get(/databases/$(database)/documents/borrowRequests/$(data.borrowRequestId)).data.status == 'completed';
    }

    function validBorrowerToOwnerReview(data, borrowData) {
      return data.role == 'borrowerToOwner' &&
        data.reviewerId == borrowData.borrowerId &&
        data.revieweeId == borrowData.ownerId;
    }

    function validOwnerToBorrowerReview(data, borrowData) {
      return data.role == 'ownerToBorrower' &&
        data.reviewerId == borrowData.ownerId &&
        data.revieweeId == borrowData.borrowerId;
    }

    function validCompletedBorrowReview(data) {
      let borrowData = get(/databases/$(database)/documents/borrowRequests/$(data.borrowRequestId)).data;
      return completedBorrowRequestForReview(data) &&
        data.itemId == borrowData.itemId &&
        (
          validBorrowerToOwnerReview(data, borrowData) ||
          validOwnerToBorrowerReview(data, borrowData)
        );
    }

    function validReviewCreate(data) {
      return signedIn() &&
        data.keys().hasOnly([
          'borrowRequestId',
          'itemId',
          'reviewerId',
          'reviewerName',
          'revieweeId',
          'revieweeName',
          'rating',
          'comment',
          'role',
          'createdAt',
        ]) &&
        data.reviewerId == request.auth.uid &&
        data.revieweeId != request.auth.uid &&
        data.reviewerName is string &&
        data.revieweeName is string &&
        data.comment is string &&
        data.rating is int &&
        data.rating >= 1 &&
        data.rating <= 5 &&
        data.role in ['borrowerToOwner', 'ownerToBorrower'] &&
        data.createdAt == request.time &&
        validCompletedBorrowReview(data);
    }

    function validRevieweeReputationUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn() &&
        request.auth.uid != resource.data.uid &&
        changed.hasOnly([
          'reputationScore',
          'totalReviews',
          'updatedAt',
        ]) &&
        (
          (
            resource.data.totalReviews is int &&
            request.resource.data.totalReviews == resource.data.totalReviews + 1
          ) ||
          (
            !resource.data.keys().hasAny(['totalReviews']) &&
            request.resource.data.totalReviews == 1
          )
        ) &&
        request.resource.data.reputationScore is number &&
        request.resource.data.reputationScore >= 0 &&
        request.resource.data.reputationScore <= 5 &&
        request.resource.data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) ||
        isAdmin() ||
        canReadCommunityResident(resource.data) ||
        signedIn();
      allow list: if isSystemAdmin() ||
        (isAdmin() && resource.data.communityId == adminCommunityId()) ||
        canReadCommunityResident(resource.data);

      allow create: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.role == 'resident' &&
        request.resource.data.verificationStatus == 'pending';

      allow update: if isAdmin() ||
        (isOwner(uid) && ownSafeUserUpdate()) ||
        validRevieweeReputationUpdate();
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if isOwner(uid) || isSystemAdmin();
      allow list: if isSystemAdmin();
      allow create, delete: if isSystemAdmin();
      allow update: if isSystemAdmin() ||
        (isOwner(uid) && ownProfileImageUpdate());
    }

    match /communities/{communityId} {
      // Community names and boundaries are needed before a resident profile exists
      // during registration and location verification. Keep writes admin-only.
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /verificationRequests/{requestId} {
      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          isSystemAdmin() ||
          adminCanAccessCommunity(resource.data.communityId)
        );

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'submitted';

      allow update: if isAdmin() ||
        (
          signedIn() &&
          resource.data.userId == request.auth.uid &&
          (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'cancelledAt',
                'cancelledBy',
              ]) &&
              request.resource.data.status == 'cancelled' &&
              request.resource.data.cancelledBy == request.auth.uid
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'documentUrl',
                'fileUrl',
                'updatedAt',
              ]) &&
              request.resource.data.userId == resource.data.userId &&
              request.resource.data.status == resource.data.status &&
              request.resource.data.storagePath == resource.data.storagePath
            )
          )
        );

      allow delete: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if signedIn();
      allow create: if isVerifiedResident() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /borrowRequests/{requestId} {
      allow read: if isAdmin() ||
        (
          signedIn() &&
          (resource.data.borrowerId == request.auth.uid ||
           resource.data.ownerId == request.auth.uid)
        );

      allow create: if isVerifiedResident() &&
        request.resource.data.borrowerId == request.auth.uid;

      allow update: if isAdmin() || validBorrowRequestUpdate();
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow create: if isVerifiedResident() &&
        request.resource.data.providerId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (signedIn() && resource.data.providerId == request.auth.uid);
    }

    match /serviceRequests/{requestId} {
      allow read: if isAdmin() ||
        (
          signedIn() &&
          (resource.data.requesterId == request.auth.uid ||
           resource.data.providerId == request.auth.uid)
        );

      allow create: if isVerifiedResident() &&
        request.resource.data.requesterId == request.auth.uid;

      allow update: if isAdmin() ||
        (
          signedIn() &&
          (resource.data.requesterId == request.auth.uid ||
           resource.data.providerId == request.auth.uid)
        );
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if validReviewCreate(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isSystemAdmin() ||
        adminCanAccessCommunity(resource.data.communityId) ||
        (isAdmin() && !resource.data.keys().hasAny(['communityId']));

      allow create: if hasProfile() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.communityId == myUserDoc().data.communityId &&
        request.resource.data.communityName == myUserDoc().data.communityName;

      allow update, delete: if isSystemAdmin() ||
        adminCanAccessCommunity(resource.data.communityId) ||
        (isAdmin() && !resource.data.keys().hasAny(['communityId']));
    }

    match /transactions/{transactionId} {
      allow read: if isSystemAdmin() ||
        adminCanAccessCommunity(resource.data.communityId);
      allow create, update, delete: if isSystemAdmin();
    }

    match /connections/{connectionId} {
      allow get: if connectionParticipant(resource.data) ||
        adminCanAccessCommunity(resource.data.communityId);

      allow list: if connectionParticipantQuery(resource.data) ||
        connectionOwnedByCurrentUser(resource.data) ||
        adminCanAccessCommunity(resource.data.communityId);

      allow create: if isVerifiedResident() &&
        request.resource.data.keys().hasOnly([
          'fromUserId',
          'toUserId',
          'participants',
          'communityId',
          'status',
          'createdAt',
          'updatedAt',
        ]) &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId != request.auth.uid &&
        request.resource.data.communityId == myUserDoc().data.communityId &&
        request.resource.data.status == 'pending' &&
        isValidConnectionParticipants(request.resource.data) &&
        targetUserCanConnect(request.resource.data);

      allow update: if recipientCanResolvePendingRequest() ||
        senderCanRefreshPendingRequest();

      allow delete: if participantCanDeleteConnection() ||
        adminCanAccessCommunity(resource.data.communityId);
    }

    match /chats/{chatId} {
      allow get: if chatParticipant(resource.data) ||
        (isVerifiedResident() &&
          !exists(/databases/$(database)/documents/chats/$(chatId)));
      allow list: if isVerifiedResident();
      allow create: if validChatCreate(request.resource.data);
      allow update: if validChatUpdate();
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if chatParticipantById(chatId);
        allow create: if validChatMessageCreate(chatId, request.resource.data);
        allow update: if validChatMessageReadUpdate(chatId);
        allow delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn() &&
        resource.data.userId == request.auth.uid;
      allow create: if signedIn();
    }

    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
