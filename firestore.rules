rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasAdminProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return hasAdminProfile() &&
        myAdminDoc().data.isActive != false &&
        myAdminDoc().data.role in ['communityAdmin', 'systemAdmin'];
    }

    function isSystemAdmin() {
      return hasAdminProfile() &&
        myAdminDoc().data.isActive != false &&
        myAdminDoc().data.role == 'systemAdmin';
    }

    function isVerifiedResident() {
      return hasProfile() &&
        myUserDoc().data.verificationStatus == 'verified';
    }

    function ownSafeUserUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
        'fullName',
        'phoneNumber',
        'phoneVerified',
        'emailVerified',
        'profileImageUrl',
        'communityId',
        'communityName',
        'unitNumber',
        'cameraEnabled',
        'cameraPermissionStatus',
        'photosDocumentsEnabled',
        'photosDocumentsPermissionStatus',
        'notificationEnabled',
        'notificationPermissionStatus',
        'fcmToken',
        'locationVerified',
        'locationVerificationStatus',
        'locationVerifiedCommunityName',
        'verificationStatus',
        'updatedAt',
      ]) &&
      (
        !changed.hasAny(['verificationStatus']) ||
        request.resource.data.verificationStatus in ['pending', 'submitted']
      );
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.role == 'resident' &&
        request.resource.data.verificationStatus == 'pending';

      allow update: if isAdmin() || (isOwner(uid) && ownSafeUserUpdate());
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if signedIn();
      allow create, update, delete: if isSystemAdmin();
    }

    match /communities/{communityId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /verificationRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'submitted';

      allow update: if isAdmin() ||
        (
          signedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'cancelledAt',
            'cancelledBy',
          ]) &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.cancelledBy == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if signedIn();
      allow create: if isVerifiedResident() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /borrowRequests/{requestId} {
      allow read: if isAdmin() ||
        (
          signedIn() &&
          (resource.data.borrowerId == request.auth.uid ||
           resource.data.ownerId == request.auth.uid)
        );

      allow create: if isVerifiedResident() &&
        request.resource.data.borrowerId == request.auth.uid;

      allow update: if isAdmin() ||
        (
          signedIn() &&
          (resource.data.borrowerId == request.auth.uid ||
           resource.data.ownerId == request.auth.uid)
        );
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow create: if isVerifiedResident() &&
        request.resource.data.providerId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (signedIn() && resource.data.providerId == request.auth.uid);
    }

    match /serviceRequests/{requestId} {
      allow read: if isAdmin() ||
        (
          signedIn() &&
          (resource.data.requesterId == request.auth.uid ||
           resource.data.providerId == request.auth.uid)
        );

      allow create: if isVerifiedResident() &&
        request.resource.data.requesterId == request.auth.uid;

      allow update: if isAdmin() ||
        (
          signedIn() &&
          (resource.data.requesterId == request.auth.uid ||
           resource.data.providerId == request.auth.uid)
        );
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin() ||
        (
          signedIn() &&
          (resource.data.reporterId == request.auth.uid ||
           resource.data.reportedUserId == request.auth.uid)
        );

      allow create: if signedIn() &&
        request.resource.data.reporterId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read, write: if signedIn() &&
        request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn() &&
        resource.data.userId == request.auth.uid;
      allow create: if signedIn();
    }

    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
