rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function borrowRequestData(requestId) {
      return firestore.get(/databases/(default)/documents/borrowRequests/$(requestId)).data;
    }

    function borrowRequestExists(requestId) {
      return firestore.exists(/databases/(default)/documents/borrowRequests/$(requestId));
    }

    function isStorageAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.isActive != false &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role in ['communityAdmin', 'systemAdmin'];
    }

    function isBorrowProofParticipant(requestId) {
      return request.auth != null &&
        borrowRequestExists(requestId) &&
        (
          request.auth.uid == borrowRequestData(requestId).borrowerId ||
          request.auth.uid == borrowRequestData(requestId).ownerId
        );
    }

    function canReadBorrowProof(requestId) {
      return isBorrowProofParticipant(requestId) || isStorageAdmin();
    }

    function isAllowedProofImageUpload() {
      return request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'image/heic',
          'image/heif'
        ];
    }

    function userExists(userId) {
      return firestore.exists(/databases/(default)/documents/users/$(userId));
    }

    function residentUserData(userId) {
      return firestore.get(/databases/(default)/documents/users/$(userId)).data;
    }

    function storageAdminData() {
      return firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data;
    }

    function isStorageSystemAdmin() {
      return isStorageAdmin() && storageAdminData().role == 'systemAdmin';
    }

    function storageAdminCommunityId() {
      return storageAdminData().communityId;
    }

    function storageAdminCanAccessCommunity(communityId) {
      return isStorageSystemAdmin() ||
        (
          isStorageAdmin() &&
          communityId is string &&
          communityId != '' &&
          communityId == storageAdminCommunityId()
        );
    }

    function verificationRequestData(requestId) {
      return firestore.get(/databases/(default)/documents/verificationRequests/$(requestId)).data;
    }

    function canReadVerificationDocumentsForUser(userId) {
      return request.auth != null && (
        request.auth.uid == userId ||
        (
          isStorageAdmin() &&
          userExists(userId) &&
          storageAdminCanAccessCommunity(residentUserData(userId).communityId)
        )
      );
    }

    function canReadResidentDocument(userId, documentId) {
      return request.auth != null && (
        request.auth.uid == userId ||
        (
          isStorageAdmin() &&
          firestore.exists(/databases/(default)/documents/verificationRequests/$(documentId)) &&
          verificationRequestData(documentId).userId == userId &&
          storageAdminCanAccessCommunity(verificationRequestData(documentId).communityId)
        )
      );
    }

    function isAllowedVerificationUpload() {
      return request.resource.size < 25 * 1024 * 1024 &&
        request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/png',
          'image/webp',
          'image/heic',
          'image/heif'
        ];
    }

    function isAllowedItemImageUpload() {
      return request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'image/heic',
          'image/heif'
        ];
    }

    // Verification documents: owner read/write; admins read within their community.
    match /verification_documents/{userId}/{allPaths=**} {
      allow read: if canReadVerificationDocumentsForUser(userId);
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        isAllowedVerificationUpload();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Document AI verification uploads. Owner writes; admins read for review.
    match /resident_documents/{userId}/{documentId}/{fileName} {
      allow read: if canReadResidentDocument(userId, documentId);
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        isAllowedVerificationUpload();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Item images: signed-in read; owner uploads with image MIME/size limits.
    match /item_images/{userId}/{itemId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        isAllowedItemImageUpload();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Profile photos: users/admins may upload only their own small image files.
    match /profile_images/{accountType}/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        accountType in ['residents', 'admins'] &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Borrow-request proof images: readable only by borrower, lender, or admin;
    // writable only by the uploader into their own folder with image limits.
    match /borrow_request_proofs/{requestId}/{userId}/{allPaths=**} {
      allow read: if canReadBorrowProof(requestId);
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        isBorrowProofParticipant(requestId) &&
        isAllowedProofImageUpload();
      allow delete: if request.auth != null &&
        request.auth.uid == userId &&
        isBorrowProofParticipant(requestId);
    }

    // Chat attachments: senders upload their own files; signed-in residents
    // download attachment files through the app before previewing/opening them.
    match /chat_attachments/{chatId}/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        (
          (
            request.resource.size < 10 * 1024 * 1024 &&
            request.resource.contentType in [
              'image/jpeg',
              'image/png',
              'image/webp',
              'image/heic',
              'image/heif'
            ]
          ) ||
          (
            request.resource.size < 25 * 1024 * 1024 &&
            request.resource.contentType in [
              'application/pdf',
              'application/msword',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
              'application/vnd.ms-excel',
              'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
              'application/vnd.ms-powerpoint',
              'application/vnd.openxmlformats-officedocument.presentationml.presentation',
              'text/plain',
              'text/csv',
              'application/octet-stream'
            ]
          ) ||
          (
            request.resource.size < 50 * 1024 * 1024 &&
            request.resource.contentType in [
              'video/mp4',
              'video/quicktime',
              'video/webm',
              'video/x-m4v'
            ]
          )
        );
    }

    // Community post cover images: admins upload their own post images.
    match /community_post_images/{adminId}/{postId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == adminId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }
  }
}
