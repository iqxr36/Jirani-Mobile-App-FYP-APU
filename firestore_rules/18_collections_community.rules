// Description     : Jirani - a community trust marketplace for verified residents to borrow items, offer services, connect with neighbors, and build reputation.
// First Written on: Friday,26-June-2026
// Last Edited on  : Saturday,18-July-2026

    // --- communityPosts and default deny ---
    match /communityPosts/{postId} {
      allow read: if signedIn() && (
        adminCanAccessCommunity(resource.data.communityId) ||
        (
          isVerifiedResident() &&
          resource.data.communityId == myUserDoc().data.communityId &&
          resource.data.status in ['published', 'expired']
        )
      );
      allow create: if validCommunityPostCreate(postId);
      allow update: if isAdmin() &&
        adminCanAccessCommunity(resource.data.communityId) &&
        validCommunityPostUpdate();
      allow delete: if isAdmin() &&
        adminCanAccessCommunity(resource.data.communityId);
    }

    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() ||
        (
          signedIn() &&
          (resource.data.payerId == request.auth.uid ||
           resource.data.receiverId == request.auth.uid)
        );
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid}/paymentMethods/{paymentMethodId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
