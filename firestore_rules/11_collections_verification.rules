// Programme Name  : 11_collections_verification.rules (Firestore rules file)
// Description     : Jirani - a community trust marketplace for verified residents to borrow items, offer services, connect with neighbors, and build reputation.
// First Written on: Friday,26-June-2026
// Last Edited on  : Saturday,18-July-2026

    // --- verificationRequests collection ---
    match /verificationRequests/{requestId} {
      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          isSystemAdmin() ||
          adminCanAccessCommunity(resource.data.communityId)
        );

      allow create: if signedIn() &&
        validVerificationCreate(request.resource.data);

      allow update: if isAdmin() ||
        (
          signedIn() &&
          resource.data.userId == request.auth.uid &&
          (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'cancelledAt',
                'cancelledBy',
              ]) &&
              request.resource.data.status == 'cancelled' &&
              request.resource.data.cancelledBy == request.auth.uid
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'documentUrl',
                'fileUrl',
                'updatedAt',
              ]) &&
              request.resource.data.userId == resource.data.userId &&
              request.resource.data.status == resource.data.status &&
              request.resource.data.storagePath == resource.data.storagePath
            )
          )
        );

      allow delete: if isAdmin();
    }
