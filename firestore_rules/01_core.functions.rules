    // --- Core auth/admin/resident helpers ---
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function myAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasAdminProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminIsActive(data) {
      return ('isActive' in data && data.isActive is bool)
        ? data.isActive
        : (
          ('status' in data && data.status is string)
            ? (data.status.size() == 0 || data.status in ['active', 'enabled'])
            : true
        );
    }

    function adminRole(data) {
      return ('role' in data && data.role is string)
        ? data.role
        : 'communityAdmin';
    }

    function adminHasValidRole(data) {
      return adminRole(data) in ['communityAdmin', 'systemAdmin'];
    }

    function isValidAdminDoc(data) {
      return adminIsActive(data) && adminHasValidRole(data);
    }

    function isAdmin() {
      return hasAdminProfile() && isValidAdminDoc(myAdminDoc().data);
    }

    function isSystemAdmin() {
      return hasAdminProfile() &&
        isValidAdminDoc(myAdminDoc().data) &&
        adminRole(myAdminDoc().data) == 'systemAdmin';
    }

    function adminCommunityId() {
      return myAdminDoc().data.communityId;
    }

    function adminCanAccessCommunity(communityId) {
      return isSystemAdmin() ||
        (
          isAdmin() &&
          communityId is string &&
          communityId != '' &&
          communityId == adminCommunityId()
        );
    }

    function hasVerifiedResidentStatus(status) {
      return status in ['verified', 'approved'];
    }

    function validCommunitySupportContact(communityId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'communityId',
          'contactName',
          'email',
          'phoneNumber',
          'updatedBy',
          'updatedAt',
        ]) &&
        data.communityId == communityId &&
        data.contactName is string &&
        data.contactName.size() > 0 &&
        data.contactName.size() <= 60 &&
        data.email is string &&
        data.email.size() > 0 &&
        data.email.size() <= 254 &&
        data.phoneNumber is string &&
        data.phoneNumber.size() > 0 &&
        data.phoneNumber.size() <= 16 &&
        data.updatedBy == request.auth.uid &&
        data.updatedAt == request.time;
    }

    function residentAccountCanAccess(data) {
      return !('accountStatus' in data) ||
        data.accountStatus == 'active' ||
        (
          data.accountStatus == 'suspended' &&
          'suspensionEndsAt' in data &&
          data.suspensionEndsAt is timestamp &&
          request.time >= data.suspensionEndsAt
        );
    }

    function isVerifiedResident() {
      return hasProfile() &&
        hasVerifiedResidentStatus(myUserDoc().data.verificationStatus) &&
        residentAccountCanAccess(myUserDoc().data);
    }

    function isVerifiedResidentData(data) {
      return data.role == 'resident' &&
        hasVerifiedResidentStatus(data.verificationStatus);
    }

    function canReadCommunityResident(data) {
      return isVerifiedResident() &&
        isVerifiedResidentData(data) &&
        data.communityId == myUserDoc().data.communityId;
    }

