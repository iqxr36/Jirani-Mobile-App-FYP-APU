    // --- Service listing helpers ---
    function serviceProvider() {
      return signedIn() && resource.data.providerId == request.auth.uid;
    }

    function serviceChangedKeysOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function serviceProviderSnapshotUnchanged() {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.providerId == resource.data.providerId &&
        request.resource.data.providerName == resource.data.providerName &&
        request.resource.data.providerEmail == resource.data.providerEmail &&
        request.resource.data.providerPhotoUrl == resource.data.providerPhotoUrl &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function serviceListingFieldsUnchanged() {
      return request.resource.data.title == resource.data.title &&
        request.resource.data.description == resource.data.description &&
        request.resource.data.category == resource.data.category &&
        request.resource.data.priceType == resource.data.priceType &&
        request.resource.data.priceAmount == resource.data.priceAmount &&
        request.resource.data.communityId == resource.data.communityId &&
        request.resource.data.communityName == resource.data.communityName &&
        request.resource.data.pricingMode == resource.data.pricingMode &&
        request.resource.data.hourlyRate == resource.data.hourlyRate &&
        request.resource.data.fixedJobPrice == resource.data.fixedJobPrice &&
        request.resource.data.imageUrls == resource.data.imageUrls &&
        request.resource.data.certificateUrls == resource.data.certificateUrls &&
        request.resource.data.certificateNames == resource.data.certificateNames &&
        request.resource.data.availability == resource.data.availability &&
        request.resource.data.get('availableWeekdays', []) == resource.data.get('availableWeekdays', []) &&
        request.resource.data.get('availabilityStartMinutes', 0) == resource.data.get('availabilityStartMinutes', 0) &&
        request.resource.data.get('availabilityEndMinutes', 0) == resource.data.get('availabilityEndMinutes', 0);
    }

    function validServiceAvailabilityFields(data) {
      return data.availableWeekdays is list &&
        data.availableWeekdays.size() > 0 &&
        data.availabilityStartMinutes is int &&
        data.availabilityEndMinutes is int &&
        data.availabilityStartMinutes >= 0 &&
        data.availabilityEndMinutes > data.availabilityStartMinutes &&
        data.availabilityEndMinutes <= 1440;
    }

    function hasValidServiceAvailability(data) {
      return !('availableWeekdays' in data) || validServiceAvailabilityFields(data);
    }

    function hasStructuredServiceAvailability(serviceData) {
      return serviceData.keys().hasAll([
          'availableWeekdays',
          'availabilityStartMinutes',
          'availabilityEndMinutes',
        ]) &&
        serviceData.availableWeekdays is list &&
        serviceData.availableWeekdays.size() > 0 &&
        serviceData.availabilityStartMinutes is int &&
        serviceData.availabilityEndMinutes is int &&
        serviceData.availabilityEndMinutes > serviceData.availabilityStartMinutes;
    }

    function validServiceAvailabilityMatch(serviceData, data) {
      return !hasStructuredServiceAvailability(serviceData) || (
        data.preferredWeekday is int &&
        data.preferredTimeMinutes is int &&
        serviceData.availableWeekdays.hasAny([data.preferredWeekday]) &&
        data.preferredTimeMinutes >= serviceData.availabilityStartMinutes &&
        data.preferredTimeMinutes < serviceData.availabilityEndMinutes
      );
    }

    function validServiceListingKeys(data) {
      return data.keys().hasOnly([
        'id',
        'providerId',
        'providerName',
        'providerEmail',
        'communityId',
        'communityName',
        'providerPhotoUrl',
        'title',
        'description',
        'category',
        'priceType',
        'priceAmount',
        'pricingMode',
        'hourlyRate',
        'fixedJobPrice',
        'imageUrls',
        'certificateUrls',
        'certificateNames',
        'availability',
        'availableWeekdays',
        'availabilityStartMinutes',
        'availabilityEndMinutes',
        'status',
        'createdAt',
        'updatedAt',
      ]);
    }

    function validServicePricing(data) {
      return (
          data.pricingMode == 'hourly' &&
          data.hourlyRate is number &&
          data.hourlyRate > 0 &&
          data.fixedJobPrice == null &&
          data.priceAmount == data.hourlyRate
        ) ||
        (
          data.pricingMode == 'fixedJob' &&
          data.fixedJobPrice is number &&
          data.fixedJobPrice > 0 &&
          data.hourlyRate == null &&
          data.priceAmount == data.fixedJobPrice
        );
    }

    function validServiceCategory(category) {
      return category in [
        'homeCleaningUpkeep',
        'repairsMaintenance',
        'assemblyLabor',
        'tutoringEducation',
        'assistanceErrands',
        'itTechSetup',
        'homeCookingMealPrep',
        'creativeDigitalTasks',
      ];
    }

    // Dispute fields (disputeType, disputeReason, disputedAt) are written by
    // Cloud Functions only — clients cannot open disputes via validServiceRequestUpdate.
    function validServiceDisputeType(disputeType) {
      return disputeType in [
        'incomplete',
        'poorQuality',
        'noShow',
        'scopeMismatch',
        'safetyConcern',
        'other',
      ];
    }

    function serviceIsEditableListing() {
      return resource.data.status == 'active';
    }

    function validServiceCommunityId(data) {
      return data.communityId is string &&
        data.communityId != '' &&
        data.communityId == myUserDoc().data.communityId;
    }

    function providerSafeServiceUpdate() {
      return serviceProvider() &&
        serviceIsEditableListing() &&
        request.resource.data.status == 'active' &&
        serviceProviderSnapshotUnchanged() &&
        serviceChangedKeysOnly([
          'title',
          'description',
          'category',
          'communityId',
          'communityName',
          'priceType',
          'priceAmount',
          'pricingMode',
          'hourlyRate',
          'fixedJobPrice',
          'imageUrls',
          'certificateUrls',
          'certificateNames',
          'availability',
          'availableWeekdays',
          'availabilityStartMinutes',
          'availabilityEndMinutes',
          'updatedAt',
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.description is string &&
        request.resource.data.category is string &&
        request.resource.data.priceType is string &&
        request.resource.data.availability is string &&
        request.resource.data.communityName is string &&
        validServiceCommunityId(request.resource.data) &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.availability.size() > 0 &&
        validServiceCategory(request.resource.data.category) &&
        request.resource.data.imageUrls is list &&
        request.resource.data.certificateUrls is list &&
        request.resource.data.certificateNames is list &&
        request.resource.data.certificateUrls.size() == request.resource.data.certificateNames.size() &&
        validServicePricing(request.resource.data) &&
        hasValidServiceAvailability(request.resource.data);
    }

    function providerCanSetServiceStatus() {
      return serviceProvider() &&
        !('adminModerationReason' in resource.data) &&
        serviceProviderSnapshotUnchanged() &&
        serviceListingFieldsUnchanged() &&
        serviceChangedKeysOnly(['status', 'updatedAt']) &&
        request.resource.data.status in ['active', 'inactive', 'archived'];
    }

    function validServiceCreate(serviceId) {
      let data = request.resource.data;
      return isVerifiedResident() &&
        validServiceListingKeys(data) &&
        data.providerId == request.auth.uid &&
        data.status == 'active' &&
        data.id == serviceId &&
        data.title is string &&
        data.description is string &&
        data.category is string &&
        validServiceCategory(data.category) &&
        data.priceType is string &&
        data.priceAmount is number &&
        data.providerPhotoUrl is string &&
        data.imageUrls is list &&
        data.certificateUrls is list &&
        data.certificateNames is list &&
        data.certificateUrls.size() == data.certificateNames.size() &&
        validServicePricing(data) &&
        data.availability is string &&
        validServiceAvailabilityFields(data) &&
        data.providerName is string &&
        data.providerEmail is string &&
        data.communityName is string &&
        validServiceCommunityId(data) &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function serviceListingProviderCommunityId() {
      return resource.data.communityId;
    }

    function canReadServiceListing() {
      return (
          isAdmin() &&
          (isSystemAdmin() || adminCanAccessCommunity(serviceListingProviderCommunityId()))
        ) ||
        serviceProvider() ||
        (
          hasProfile() &&
          serviceListingProviderCommunityId() == myUserDoc().data.communityId
        );
    }

    function serviceRequestChangedKeysOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function serviceRequestSnapshotUnchanged() {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.serviceId == resource.data.serviceId &&
        request.resource.data.serviceTitle == resource.data.serviceTitle &&
        request.resource.data.providerId == resource.data.providerId &&
        request.resource.data.providerName == resource.data.providerName &&
        request.resource.data.requesterId == resource.data.requesterId &&
        request.resource.data.requesterName == resource.data.requesterName &&
        request.resource.data.message == resource.data.message &&
        request.resource.data.preferredDate == resource.data.preferredDate &&
        request.resource.data.preferredTime == resource.data.preferredTime &&
        request.resource.data.get('preferredWeekday', null) == resource.data.get('preferredWeekday', null) &&
        request.resource.data.get('preferredTimeMinutes', null) == resource.data.get('preferredTimeMinutes', null) &&
        request.resource.data.get('amount', null) == resource.data.get('amount', null) &&
        request.resource.data.get('durationHours', null) == resource.data.get('durationHours', null) &&
        request.resource.data.get('hourlyRate', null) == resource.data.get('hourlyRate', null) &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function serviceRequestProvider() {
      return signedIn() && resource.data.providerId == request.auth.uid;
    }

    function serviceRequestRequester() {
      return signedIn() && resource.data.requesterId == request.auth.uid;
    }

    function serviceRequestUpdatedAtIsNow() {
      return request.resource.data.updatedAt == request.time;
    }

    function providerCanAcceptServiceRequest() {
      return serviceRequestProvider() &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['accepted', 'acceptedAwaitingPayment'] &&
        (
          (resource.data.get('amount', 0) is number &&
            resource.data.get('amount', 0) > 0 &&
            request.resource.data.status == 'acceptedAwaitingPayment') ||
          ((!(resource.data.get('amount', 0) is number) || resource.data.get('amount', 0) <= 0) &&
            request.resource.data.status == 'accepted')
        ) &&
        serviceRequestSnapshotUnchanged() &&
        serviceRequestUpdatedAtIsNow() &&
        serviceRequestChangedKeysOnly(['status', 'updatedAt']);
    }

    function providerCanRejectServiceRequest() {
      return serviceRequestProvider() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'rejected' &&
        serviceRequestSnapshotUnchanged() &&
        serviceRequestUpdatedAtIsNow() &&
        serviceRequestChangedKeysOnly(['status', 'updatedAt']);
    }

    function providerCanCompleteServiceRequest() {
      return serviceRequestProvider() &&
        resource.data.status == 'accepted' &&
        request.resource.data.status == 'completed' &&
        serviceRequestSnapshotUnchanged() &&
        serviceRequestUpdatedAtIsNow() &&
        serviceRequestChangedKeysOnly(['status', 'updatedAt']);
    }

    function requesterCanCancelServiceRequest() {
      return serviceRequestRequester() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'cancelled' &&
        serviceRequestSnapshotUnchanged() &&
        serviceRequestUpdatedAtIsNow() &&
        serviceRequestChangedKeysOnly(['status', 'updatedAt']);
    }

    function requesterCanCancelAwaitingPaymentServiceRequest() {
      return serviceRequestRequester() &&
        resource.data.status == 'acceptedAwaitingPayment' &&
        request.resource.data.status == 'cancelled' &&
        serviceRequestSnapshotUnchanged() &&
        serviceRequestUpdatedAtIsNow() &&
        serviceRequestChangedKeysOnly(['status', 'updatedAt']);
    }

    function validServiceRequestUpdate() {
      return providerCanAcceptServiceRequest() ||
        providerCanRejectServiceRequest() ||
        providerCanCompleteServiceRequest() ||
        requesterCanCancelServiceRequest() ||
        requesterCanCancelAwaitingPaymentServiceRequest();
    }

    function validServiceRequestCreateKeys(data) {
      return data.keys().hasOnly([
        'id',
        'serviceId',
        'serviceTitle',
        'providerId',
        'providerName',
        'requesterId',
        'requesterName',
        'message',
        'preferredDate',
        'preferredTime',
        'preferredWeekday',
        'preferredTimeMinutes',
        'amount',
        'durationHours',
        'hourlyRate',
        'currency',
        'paymentStatus',
        'paymentId',
        'paymentProvider',
        'platformFeeAmount',
        'providerPayoutAmount',
        'payoutStatus',
        'refundStatus',
        'status',
        'createdAt',
        'updatedAt',
      ]);
    }

    function validServiceRequestCreate(requestId) {
      let data = request.resource.data;
      let serviceData = get(/databases/$(database)/documents/services/$(data.serviceId)).data;
      return isVerifiedResident() &&
        validServiceRequestCreateKeys(data) &&
        data.id == requestId &&
        data.requesterId == request.auth.uid &&
        data.serviceId is string &&
        exists(/databases/$(database)/documents/services/$(data.serviceId)) &&
        exists(/databases/$(database)/documents/users/$(serviceData.providerId)) &&
        serviceData.status == 'active' &&
        serviceData.providerId != request.auth.uid &&
        data.providerId == serviceData.providerId &&
        data.serviceTitle == serviceData.title &&
        data.providerName == serviceData.providerName &&
        userDoc(data.providerId).data.communityId == myUserDoc().data.communityId &&
        data.requesterName is string &&
        data.message is string &&
        data.preferredDate is timestamp &&
        data.preferredTime is string &&
        data.preferredWeekday is int &&
        data.preferredTimeMinutes is int &&
        data.preferredWeekday >= 1 &&
        data.preferredWeekday <= 7 &&
        data.preferredTimeMinutes >= 0 &&
        data.preferredTimeMinutes < 1440 &&
        validServiceAvailabilityMatch(serviceData, data) &&
        data.amount is number &&
        data.amount > 0 &&
        data.currency == 'myr' &&
        data.paymentStatus == 'pending' &&
        data.paymentId == '' &&
        data.paymentProvider == '' &&
        data.platformFeeAmount == 0 &&
        data.providerPayoutAmount == data.amount &&
        data.payoutStatus == 'notStarted' &&
        data.refundStatus == 'not_started' &&
        (
          (
            serviceData.pricingMode == 'hourly' &&
            data.durationHours is int &&
            data.durationHours >= 1 &&
            data.durationHours <= 12 &&
            data.hourlyRate == serviceData.hourlyRate &&
            data.amount == serviceData.hourlyRate * data.durationHours
          ) ||
          (
            serviceData.pricingMode == 'fixedJob' &&
            data.durationHours == null &&
            data.hourlyRate == null &&
            data.amount == serviceData.fixedJobPrice
          )
        ) &&
        data.status == 'pending' &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }
