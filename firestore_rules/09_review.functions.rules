    // --- Review and profile image helpers ---
    function validAdminNotificationPreferences(prefs) {
      return prefs is map &&
        prefs.keys().hasOnly([
          'verificationAlerts',
          'reportEscalations',
          'serviceDisputeAlerts',
          'weeklyDigest',
        ]) &&
        prefs.verificationAlerts is bool &&
        prefs.reportEscalations is bool &&
        prefs.serviceDisputeAlerts is bool &&
        prefs.weeklyDigest is bool;
    }

    function adminImmutableFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'email',
        'role',
        'communityId',
        'communityName',
        'permissions',
        'isActive',
        'createdAt',
      ]);
    }

    function ownAdminSelfProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return hasAdminProfile() &&
        isValidAdminDoc(myAdminDoc().data) &&
        changed.hasOnly([
          'fullName',
          'phoneNumber',
          'notificationPreferences',
          'profileImageUrl',
          'themePresetId',
          'updatedAt',
        ]) &&
        (
          !changed.hasAny(['fullName']) ||
          request.resource.data.fullName is string
        ) &&
        (
          !changed.hasAny(['phoneNumber']) ||
          request.resource.data.phoneNumber is string
        ) &&
        (
          !changed.hasAny(['profileImageUrl']) ||
          request.resource.data.profileImageUrl is string
        ) &&
        (
          !changed.hasAny(['themePresetId']) ||
          request.resource.data.themePresetId in [
            'teal',
            'darkPurple',
            'maroon',
            'darkBlue',
          ]
        ) &&
        (
          !changed.hasAny(['notificationPreferences']) ||
          validAdminNotificationPreferences(
            request.resource.data.notificationPreferences
          )
        ) &&
        adminImmutableFieldsUnchanged();
    }

    function ownProfileImageUpdate() {
      return ownAdminSelfProfileUpdate() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'profileImageUrl',
          'updatedAt',
        ]);
    }

    function completedBorrowRequestForReview(data) {
      return data.borrowRequestId is string &&
        exists(/databases/$(database)/documents/borrowRequests/$(data.borrowRequestId)) &&
        get(/databases/$(database)/documents/borrowRequests/$(data.borrowRequestId)).data.status == 'completed';
    }

    function validBorrowerToOwnerReview(data, borrowData) {
      return data.role == 'borrowerToOwner' &&
        data.reviewerId == borrowData.borrowerId &&
        data.revieweeId == borrowData.ownerId;
    }

    function validOwnerToBorrowerReview(data, borrowData) {
      return data.role == 'ownerToBorrower' &&
        data.reviewerId == borrowData.ownerId &&
        data.revieweeId == borrowData.borrowerId;
    }

    function validCompletedBorrowReview(data) {
      let borrowData = get(/databases/$(database)/documents/borrowRequests/$(data.borrowRequestId)).data;
      return completedBorrowRequestForReview(data) &&
        data.itemId == borrowData.itemId &&
        (
          validBorrowerToOwnerReview(data, borrowData) ||
          validOwnerToBorrowerReview(data, borrowData)
        );
    }

    function validReviewCreate(reviewId, data) {
      return signedIn() &&
        data.keys().hasOnly([
          'borrowRequestId',
          'itemId',
          'reviewerId',
          'reviewerName',
          'revieweeId',
          'revieweeName',
          'rating',
          'comment',
          'role',
          'visible',
          'status',
          'publishAfter',
          'publishedAt',
          'createdAt',
        ]) &&
        reviewId == data.borrowRequestId + '_' + request.auth.uid &&
        data.reviewerId == request.auth.uid &&
        data.revieweeId != request.auth.uid &&
        data.reviewerName is string &&
        data.revieweeName is string &&
        data.comment is string &&
        data.rating is int &&
        data.rating >= 1 &&
        data.rating <= 5 &&
        data.role in ['borrowerToOwner', 'ownerToBorrower'] &&
        data.visible == false &&
        data.status == 'hidden' &&
        data.publishAfter is timestamp &&
        data.publishedAt == null &&
        data.createdAt is timestamp &&
        data.createdAt <= request.time &&
        validCompletedBorrowReview(data);
    }

    function canReadPublicProfile(data) {
      return isVerifiedResident() &&
        data.role == 'resident' &&
        hasVerifiedResidentStatus(data.verificationStatus) &&
        data.communityId == myUserDoc().data.communityId;
    }
