// Programme Name  : 15_collections_chat.rules (Firestore rules file)
// Description     : Jirani - a community trust marketplace for verified residents to borrow items, offer services, connect with neighbors, and build reputation.
// First Written on: Friday,26-June-2026
// Last Edited on  : Saturday,18-July-2026

    // --- chats collection ---
    match /chats/{chatId} {
      allow get: if chatParticipant(resource.data) ||
        (isVerifiedResident() &&
          !exists(/databases/$(database)/documents/chats/$(chatId)));
      // Chat inbox queries must prove that every returned chat contains the
      // signed-in resident. This remains valid while community re-verification
      // is pending, so old chats can be archived without exposing other chats.
      allow list: if chatParticipantLookup(resource.data);
      allow create: if validChatCreate(request.resource.data);
      allow update: if validChatUpdate();
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if chatParticipantById(chatId);
        allow create: if validChatMessageCreate(chatId, request.resource.data);
        allow update: if validChatMessageReadUpdate(chatId) ||
          validChatMessageDeleteForUser(chatId);
        allow delete: if false;
      }
    }
