// Programmer Name : Mr. Faisal Mohammed Ezzaddin Saif Ahmed
// Programme Name  : 10_collections_users.rules (Firestore rules file)
// Description     : Jirani - a community trust marketplace for verified residents to borrow items, offer services, connect with neighbors, and build reputation.
// First Written on: Friday,26-June-2026
// Last Edited on  : Saturday,18-July-2026

    // --- users collection ---
    match /users/{uid} {
      allow get: if isOwner(uid) ||
        isSystemAdmin() ||
        (isAdmin() && adminCanAccessCommunity(resource.data.communityId));
      allow list: if isSystemAdmin() ||
        (isAdmin() && resource.data.communityId == adminCommunityId());

      // Registration is finalized by the privileged Cloud Function, so clients
      // cannot create private resident profiles directly.
      allow create: if false;

      // Trust/reputation fields are updated only by Cloud Functions (Admin SDK)
      // or manually by admins — never by resident clients.
      allow update: if isAdmin() ||
        (isOwner(uid) && ownSafeUserUpdate() && validResidentSelfProfileData()) ||
        (isOwner(uid) && ownerCanChangeCommunityWithVerificationReset());
      allow delete: if isAdmin();
    }

    // Community-visible resident fields only. Synced from /users by Cloud Functions.
    match /publicProfiles/{uid} {
      allow get: if isOwner(uid) ||
        isAdmin() ||
        canReadPublicProfile(resource.data);
      allow list: if isVerifiedResident() &&
        resource.data.communityId == myUserDoc().data.communityId;
      allow create, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if isOwner(uid) || isSystemAdmin();
      allow list: if isSystemAdmin();
      allow create, delete: if isSystemAdmin();
      allow update: if isSystemAdmin() ||
        (isOwner(uid) && ownAdminSelfProfileUpdate());
    }

    match /communities/{communityId} {
      // Community names and boundaries are needed before a resident profile exists
      // during registration and location verification. Keep writes admin-only.
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /communitySupportContacts/{communityId} {
      allow get: if isSystemAdmin() ||
        adminCanAccessCommunity(communityId) ||
        (
          hasProfile() &&
          myUserDoc().data.communityId == communityId
        );
      allow list: if false;
      allow create, update: if adminCanAccessCommunity(communityId) &&
        validCommunitySupportContact(communityId);
      allow delete: if isSystemAdmin();
    }

    // Phone uniqueness registry — written only by Cloud Functions (Admin SDK).
    match /residentPhoneNumbers/{phoneHash} {
      allow read, write: if false;
    }
